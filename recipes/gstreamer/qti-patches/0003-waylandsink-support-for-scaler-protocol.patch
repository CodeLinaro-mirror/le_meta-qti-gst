From 4faa3e51b983ed64614461a966402990938dd47c Mon Sep 17 00:00:00 2001
From: Amrutha Sai Gattu <agattu@codeaurora.org>
Date: Tue, 3 Sep 2019 13:58:35 +0300
Subject: [CHANGE 3/4] waylandsink: support for scaler protocol

---
 ext/wayland/Makefile.am      |  7 +++--
 ext/wayland/gstwaylandsink.c | 68 ++++++++++++++++++++++++++++++++++++++++++--
 ext/wayland/gstwaylandsink.h |  1 +
 ext/wayland/wldisplay.c      | 13 ++++++++-
 ext/wayland/wldisplay.h      |  2 ++
 ext/wayland/wlwindow.c       | 63 +++++++++++++++++++++++++++++-----------
 ext/wayland/wlwindow.h       | 10 ++++---
 7 files changed, 138 insertions(+), 26 deletions(-)

diff --git a/ext/wayland/Makefile.am b/ext/wayland/Makefile.am
index 41ca5c7..854ad1f 100644
--- a/ext/wayland/Makefile.am
+++ b/ext/wayland/Makefile.am
@@ -6,7 +6,9 @@ BUILT_SOURCES = \
 	linux-dmabuf-unstable-v1-protocol.c \
 	linux-dmabuf-unstable-v1-client-protocol.h \
 	xdg-shell-protocol.c \
-	xdg-shell-client-protocol.h
+	xdg-shell-client-protocol.h \
+	scaler-protocol.c \
+	scaler-client-protocol.h
 
 libgstwaylandsink_la_SOURCES =  \
 	gstwaylandsink.c \
@@ -20,7 +22,8 @@ libgstwaylandsink_la_SOURCES =  \
 nodist_libgstwaylandsink_la_SOURCES = \
 	viewporter-protocol.c \
 	linux-dmabuf-unstable-v1-protocol.c \
-	xdg-shell-protocol.c
+	xdg-shell-protocol.c \
+	scaler-protocol.c
 
 libgstwaylandsink_la_CFLAGS = \
 	$(GST_PLUGINS_BAD_CFLAGS) \
diff --git a/ext/wayland/gstwaylandsink.c b/ext/wayland/gstwaylandsink.c
index 377034f..553a3b4 100644
--- a/ext/wayland/gstwaylandsink.c
+++ b/ext/wayland/gstwaylandsink.c
@@ -63,7 +63,11 @@ enum
   PROP_0,
   PROP_DISPLAY,
   PROP_XDG_SHELL,
-  PROP_FULLSCREEN
+  PROP_FULLSCREEN,
+  PROP_X,
+  PROP_Y,
+  PROP_DST_WIDTH,
+  PROP_DST_HEIGHT,
 };
 
 GST_DEBUG_CATEGORY (gstwayland_debug);
@@ -214,6 +218,24 @@ gst_wayland_sink_class_init (GstWaylandSinkClass * klass)
       g_param_spec_boolean ("fullscreen", "Fullscreen",
           "Whether the surface should be made fullscreen ", FALSE,
           G_PARAM_READWRITE | G_PARAM_CONSTRUCT | G_PARAM_STATIC_STRINGS));
+
+  g_object_class_install_property (gobject_class, PROP_X,
+      g_param_spec_uint ("x", "X Position", "X postion for the content",
+          0, 1920, 0, G_PARAM_READWRITE | G_PARAM_CONSTRUCT));
+
+  g_object_class_install_property (gobject_class, PROP_Y,
+      g_param_spec_uint ("y", "Y Position", "Y postion for the content",
+          0, 1080, 0, G_PARAM_READWRITE | G_PARAM_CONSTRUCT));
+
+  g_object_class_install_property (gobject_class, PROP_DST_WIDTH,
+      g_param_spec_uint ("width", "Destination Width", "Destination Width "
+          "for the content", 0, 1920, 640,
+          G_PARAM_READWRITE | G_PARAM_CONSTRUCT));
+
+  g_object_class_install_property (gobject_class, PROP_DST_HEIGHT,
+      g_param_spec_uint ("height", "Destination Height", "Destination Height "
+          "for the content", 0, 1080, 480,
+          G_PARAM_READWRITE | G_PARAM_CONSTRUCT));
 }
 
 static void
@@ -245,6 +267,26 @@ gst_wayland_sink_get_property (GObject * object,
       g_value_set_boolean (value, sink->fullscreen);
       GST_OBJECT_UNLOCK (sink);
       break;
+    case PROP_X:
+      GST_OBJECT_LOCK (sink);
+      g_value_set_uint (value, sink->video_rectangle.x);
+      GST_OBJECT_UNLOCK (sink);
+      break;
+    case PROP_Y:
+      GST_OBJECT_LOCK (sink);
+      g_value_set_uint (value, sink->video_rectangle.y);
+      GST_OBJECT_UNLOCK (sink);
+      break;
+    case PROP_DST_WIDTH:
+      GST_OBJECT_LOCK (sink);
+      g_value_set_uint (value, sink->video_rectangle.w);
+      GST_OBJECT_UNLOCK (sink);
+      break;
+    case PROP_DST_HEIGHT:
+      GST_OBJECT_LOCK (sink);
+      g_value_set_uint (value, sink->video_rectangle.h);
+      GST_OBJECT_UNLOCK (sink);
+      break;
     default:
       G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
       break;
@@ -273,6 +315,26 @@ gst_wayland_sink_set_property (GObject * object,
       sink->fullscreen = g_value_get_boolean (value);
       GST_OBJECT_UNLOCK (sink);
       break;
+    case PROP_X:
+      GST_OBJECT_LOCK (sink);
+      sink->video_rectangle.x = g_value_get_uint (value);
+      GST_OBJECT_UNLOCK (sink);
+      break;
+    case PROP_Y:
+      GST_OBJECT_LOCK (sink);
+      sink->video_rectangle.y = g_value_get_uint (value);
+      GST_OBJECT_UNLOCK (sink);
+      break;
+    case PROP_DST_WIDTH:
+      GST_OBJECT_LOCK (sink);
+      sink->video_rectangle.w = g_value_get_uint (value);
+      GST_OBJECT_UNLOCK (sink);
+      break;
+    case PROP_DST_HEIGHT:
+      GST_OBJECT_LOCK (sink);
+      sink->video_rectangle.h = g_value_get_uint (value);
+      GST_OBJECT_UNLOCK (sink);
+      break;
     default:
       G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
       break;
@@ -691,8 +753,8 @@ gst_wayland_sink_show_frame (GstVideoSink * vsink, GstBuffer * buffer)
     if (!sink->window) {
       /* if we were not provided a window, create one ourselves */
       sink->window = gst_wl_window_new_toplevel (sink->display,
-          &sink->video_info, sink->fullscreen, sink->use_xdg_shell,
-          &sink->render_lock);
+          &sink->video_info, &sink->video_rectangle, sink->fullscreen,
+          sink->use_xdg_shell, &sink->render_lock);
     }
   }
 
diff --git a/ext/wayland/gstwaylandsink.h b/ext/wayland/gstwaylandsink.h
index e29b508..3083967 100644
--- a/ext/wayland/gstwaylandsink.h
+++ b/ext/wayland/gstwaylandsink.h
@@ -64,6 +64,7 @@ struct _GstWaylandSink
 
   gboolean use_xdg_shell;
   gchar *display_name;
+  GstVideoRectangle video_rectangle;
 
   gboolean redraw_pending;
   GMutex render_lock;
diff --git a/ext/wayland/wldisplay.c b/ext/wayland/wldisplay.c
index a76b61c..4aa0b3e 100644
--- a/ext/wayland/wldisplay.c
+++ b/ext/wayland/wldisplay.c
@@ -81,6 +81,9 @@ gst_wl_display_finalize (GObject * gobject)
   if (self->viewporter)
     wp_viewporter_destroy (self->viewporter);
 
+  if (self->scaler)
+    wl_scaler_destroy (self->scaler);
+
   if (self->shm)
     wl_shm_destroy (self->shm);
 
@@ -237,6 +240,9 @@ registry_handle_global (void *data, struct wl_registry *registry,
   } else if (g_strcmp0 (interface, "wp_viewporter") == 0) {
     self->viewporter =
         wl_registry_bind (registry, id, &wp_viewporter_interface, 1);
+  } else if (g_strcmp0(interface, "wl_scaler") == 0) {
+    self->scaler =
+        wl_registry_bind (registry, id, &wl_scaler_interface, MIN (version, 2));
   } else if (g_strcmp0 (interface, "zwp_linux_dmabuf_v1") == 0) {
     self->dmabuf =
         wl_registry_bind (registry, id, &zwp_linux_dmabuf_v1_interface, 1);
@@ -352,7 +358,12 @@ gst_wl_display_new_existing (struct wl_display * display,
    * compositor that don't implement this extension. */
   if (!self->viewporter) {
     g_warning ("Wayland compositor is missing the ability to scale, video "
-        "display may not work properly.");
+        "display may not work properly. - No viewporter present");
+  }
+
+  if (!self->scaler) {
+    g_warning ("Wayland compositor is missing the ability to scale, video "
+        "display may not work properly - No scaler present");
   }
 
   if (!self->dmabuf) {
diff --git a/ext/wayland/wldisplay.h b/ext/wayland/wldisplay.h
index 33eaac7..cd061cd 100644
--- a/ext/wayland/wldisplay.h
+++ b/ext/wayland/wldisplay.h
@@ -26,6 +26,7 @@
 #include <wayland-client.h>
 #include "xdg-shell-client-protocol.h"
 #include "viewporter-client-protocol.h"
+#include "scaler-client-protocol.h"
 #include "linux-dmabuf-unstable-v1-client-protocol.h"
 
 G_BEGIN_DECLS
@@ -56,6 +57,7 @@ struct _GstWlDisplay
   struct xdg_shell *xdgshell;
   struct wl_shm *shm;
   struct wp_viewporter *viewporter;
+  struct wl_scaler *scaler;
   struct zwp_linux_dmabuf_v1 *dmabuf;
   GArray *shm_formats;
   GArray *dmabuf_formats;
diff --git a/ext/wayland/wlwindow.c b/ext/wayland/wlwindow.c
index 573bd92..5767cbd 100644
--- a/ext/wayland/wlwindow.c
+++ b/ext/wayland/wlwindow.c
@@ -121,8 +121,11 @@ gst_wl_window_finalize (GObject * gobject)
   if (self->shell_surface)
     wl_shell_surface_destroy (self->shell_surface);
 
-  if (self->video_viewport)
-    wp_viewport_destroy (self->video_viewport);
+  if (self->wp_video_viewport)
+    wp_viewport_destroy (self->wp_video_viewport);
+
+  if (self->wl_video_viewport)
+    wl_viewport_destroy (self->wl_video_viewport);
 
   wl_subsurface_destroy (self->video_subsurface);
   wl_surface_destroy (self->video_surface);
@@ -130,8 +133,11 @@ gst_wl_window_finalize (GObject * gobject)
   if (self->area_subsurface)
     wl_subsurface_destroy (self->area_subsurface);
 
-  if (self->area_viewport)
-    wp_viewport_destroy (self->area_viewport);
+  if (self->wp_area_viewport)
+    wp_viewport_destroy (self->wp_area_viewport);
+
+  if (self->wl_area_viewport)
+    wl_viewport_destroy (self->wl_area_viewport);
 
   wl_surface_destroy (self->area_surface);
 
@@ -164,9 +170,14 @@ gst_wl_window_new_internal (GstWlDisplay * display, GMutex * render_lock)
   wl_subsurface_set_desync (window->video_subsurface);
 
   if (display->viewporter) {
-    window->area_viewport = wp_viewporter_get_viewport (display->viewporter,
+    window->wp_area_viewport = wp_viewporter_get_viewport (display->viewporter,
+        window->area_surface);
+    window->wp_video_viewport = wp_viewporter_get_viewport (display->viewporter,
+        window->video_surface);
+  } else if (display->scaler) {
+    window->wl_area_viewport = wl_scaler_get_viewport (display->scaler,
         window->area_surface);
-    window->video_viewport = wp_viewporter_get_viewport (display->viewporter,
+    window->wl_video_viewport = wl_scaler_get_viewport (display->scaler,
         window->video_surface);
   }
 
@@ -204,10 +215,10 @@ gst_wl_window_ensure_fullscreen (GstWlWindow * window, gboolean fullscreen)
 
 GstWlWindow *
 gst_wl_window_new_toplevel (GstWlDisplay * display, const GstVideoInfo * info,
-    gboolean fullscreen, gboolean xdgshell, GMutex * render_lock)
+    const GstVideoRectangle * rectangle, gboolean fullscreen, gboolean xdgshell,
+    GMutex * render_lock)
 {
   GstWlWindow *window;
-  gint width;
 
   window = gst_wl_window_new_internal (display, render_lock);
 
@@ -245,10 +256,21 @@ gst_wl_window_new_toplevel (GstWlDisplay * display, const GstVideoInfo * info,
     GST_INFO ("Using wl_shell_surface");
   }
 
-  /* set the initial size to be the same as the reported video size */
-  width =
-      gst_util_uint64_scale_int_round (info->width, info->par_n, info->par_d);
-  gst_wl_window_set_render_rectangle (window, 0, 0, width, info->height);
+  if ((rectangle->h != 0) && (rectangle->w != 0) && !fullscreen) {
+    gst_wl_window_set_render_rectangle (window, 0, 0, rectangle->w,
+         rectangle->h);
+
+    if (window->xdg_surface)
+      xdg_surface_set_pos (window->xdg_surface, rectangle->x, rectangle->y);
+  } else {
+    /* set the initial size to be the same as the reported video size */
+    gint width = gst_util_uint64_scale_int_round (
+        info->width, info->par_n, info->par_d);
+    gst_wl_window_set_render_rectangle (window, 0, 0, width, info->height);
+
+    if (window->xdg_surface)
+      xdg_surface_set_pos (window->xdg_surface, 0, 0);
+  }
 
   return window;
 }
@@ -306,9 +328,12 @@ gst_wl_window_resize_video_surface (GstWlWindow * window, gboolean commit)
   dst.w = window->render_rectangle.w;
   dst.h = window->render_rectangle.h;
 
-  if (window->video_viewport) {
+  if (window->wp_video_viewport) {
+    gst_video_sink_center_rect (src, dst, &res, TRUE);
+    wp_viewport_set_destination (window->wp_video_viewport, res.w, res.h);
+  } else if (window->wl_video_viewport) {
     gst_video_sink_center_rect (src, dst, &res, TRUE);
-    wp_viewport_set_destination (window->video_viewport, res.w, res.h);
+    wl_viewport_set_destination (window->wl_video_viewport, res.w, res.h);
   } else {
     gst_video_sink_center_rect (src, dst, &res, FALSE);
   }
@@ -411,6 +436,9 @@ gst_wl_window_update_borders (GstWlWindow * window)
   if (window->display->viewporter) {
     width = height = 1;
     window->no_border_update = TRUE;
+  } else if (window->display->scaler) {
+    width = height = 1;
+    window->no_border_update = TRUE;
   } else {
     width = window->render_rectangle.w;
     height = window->render_rectangle.h;
@@ -458,8 +486,11 @@ gst_wl_window_set_render_rectangle (GstWlWindow * window, gint x, gint y,
     wl_subsurface_set_position (window->area_subsurface, x, y);
 
   /* change the size of the area */
-  if (window->area_viewport)
-    wp_viewport_set_destination (window->area_viewport, w, h);
+  if (window->wp_area_viewport) {
+    wp_viewport_set_destination (window->wp_area_viewport, w, h);
+  } else if (window->wl_area_viewport) {
+    wl_viewport_set_destination (window->wl_area_viewport, w, h);
+  }
 
   gst_wl_window_update_borders (window);
 
diff --git a/ext/wayland/wlwindow.h b/ext/wayland/wlwindow.h
index 6a3eca9..9aecd6e 100644
--- a/ext/wayland/wlwindow.h
+++ b/ext/wayland/wlwindow.h
@@ -46,10 +46,12 @@ struct _GstWlWindow
   GstWlDisplay *display;
   struct wl_surface *area_surface;
   struct wl_subsurface *area_subsurface;
-  struct wp_viewport *area_viewport;
+  struct wp_viewport *wp_area_viewport;
+  struct wl_viewport *wl_area_viewport;
   struct wl_surface *video_surface;
   struct wl_subsurface *video_subsurface;
-  struct wp_viewport *video_viewport;
+  struct wp_viewport *wp_video_viewport;
+  struct wl_viewport *wl_video_viewport;
   struct wl_shell_surface *shell_surface;
   struct xdg_surface *xdg_surface;
 
@@ -78,8 +80,8 @@ GType gst_wl_window_get_type (void);
 void gst_wl_window_ensure_fullscreen (GstWlWindow * window,
         gboolean fullscreen);
 GstWlWindow *gst_wl_window_new_toplevel (GstWlDisplay * display,
-        const GstVideoInfo * info, gboolean fullscreen, gboolean xdgshell,
-        GMutex * render_lock);
+        const GstVideoInfo * info, const GstVideoRectangle * rectangle,
+        gboolean fullscreen, gboolean xdgshell, GMutex * render_lock);
 GstWlWindow *gst_wl_window_new_in_surface (GstWlDisplay * display,
         struct wl_surface * parent, GMutex * render_lock);
 
