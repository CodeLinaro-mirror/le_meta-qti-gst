From 840704d7334318defaa8d4b8b5ea6076e8d9a198 Mon Sep 17 00:00:00 2001
From: Amrutha Sai Gattu <agattu@codeaurora.org>
Date: Tue, 3 Sep 2019 18:22:02 +0300
Subject: [PATCH] waylandsink: support for xdg-shell protocol

---
 configure.ac                 |   8 +-
 ext/wayland/Makefile.am      |   9 +-
 ext/wayland/gstwaylandsink.c |  19 ++++-
 ext/wayland/gstwaylandsink.h |   1 +
 ext/wayland/wldisplay.c      |  35 +++++++-
 ext/wayland/wldisplay.h      |   6 ++
 ext/wayland/wlwindow.c       | 161 +++++++++++++++++++++++++++++++----
 ext/wayland/wlwindow.h       |  10 ++-
 8 files changed, 225 insertions(+), 24 deletions(-)

diff --git a/configure.ac b/configure.ac
index 2cbf48a..6243909 100644
--- a/configure.ac
+++ b/configure.ac
@@ -1330,7 +1330,7 @@ dnl **** Wayland ****
 translit(dnm, m, l) AM_CONDITIONAL(USE_WAYLAND, true)
 AC_PATH_PROG([wayland_scanner], [wayland-scanner])
 AG_GST_CHECK_FEATURE(WAYLAND, [wayland sink], wayland , [
-  PKG_CHECK_MODULES(WAYLAND, wayland-client >= 1.4.0 libdrm >= 2.4.55 wayland-protocols >= 1.4, [
+  PKG_CHECK_MODULES(WAYLAND, wayland-client >= 1.4.0 libdrm >= 2.4.55 wayland-protocols >= 1.12, [
     if test "x$wayland_scanner" != "x"; then
       HAVE_WAYLAND="yes"
       AC_SUBST(WAYLAND_PROTOCOLS_DATADIR, `$PKG_CONFIG --variable=pkgdatadir wayland-protocols`)
@@ -1343,6 +1343,12 @@ AG_GST_CHECK_FEATURE(WAYLAND, [wayland sink], wayland , [
   ])
 ])
 
+AC_ARG_ENABLE([xdg-shell-protocol],
+   AC_HELP_STRING([--enable-xdg-shell-protocol],
+      [Use xdg shell protocol [default=no]]),
+      [use_xdg_shell_protocol="${enableval}"])
+AM_CONDITIONAL([XDG_SHELL_PROTOCOL], [test "x${use_xdg_shell_protocol}" = "xyes"])
+
 dnl **** WebP ****
 translit(dnm, m, l) AM_CONDITIONAL(USE_WEBP, true)
 AG_GST_CHECK_FEATURE(WEBP, [WebP], webp , [
diff --git a/ext/wayland/Makefile.am b/ext/wayland/Makefile.am
index 387f84f..6d93c19 100644
--- a/ext/wayland/Makefile.am
+++ b/ext/wayland/Makefile.am
@@ -17,7 +17,7 @@ libgstwaylandsink_la_SOURCES =  \
 
 nodist_libgstwaylandsink_la_SOURCES = \
 	viewporter-protocol.c \
-	linux-dmabuf-unstable-v1-protocol.c
+    linux-dmabuf-unstable-v1-protocol.c
 
 libgstwaylandsink_la_CFLAGS = \
 	$(GST_PLUGINS_BAD_CFLAGS) \
@@ -32,6 +32,13 @@ libgstwaylandsink_la_LIBADD = \
 	$(WAYLAND_LIBS)
 libgstwaylandsink_la_LDFLAGS = $(GST_PLUGIN_LDFLAGS)
 
+if XDG_SHELL_PROTOCOL
+BUILT_SOURCES += xdg-shell-unstable-v6-protocol.c \
+                 xdg-shell-unstable-v6-client-protocol.h
+nodist_libgstwaylandsink_la_SOURCES += xdg-shell-unstable-v6-protocol.c
+libgstwaylandsink_la_CFLAGS += -D__XDG_SHELL_PROTOCOL
+endif
+
 noinst_HEADERS = \
 	gstwaylandsink.h \
 	wlshmallocator.h \
diff --git a/ext/wayland/gstwaylandsink.c b/ext/wayland/gstwaylandsink.c
index d06ff99..377034f 100644
--- a/ext/wayland/gstwaylandsink.c
+++ b/ext/wayland/gstwaylandsink.c
@@ -62,6 +62,7 @@ enum
 {
   PROP_0,
   PROP_DISPLAY,
+  PROP_XDG_SHELL,
   PROP_FULLSCREEN
 };
 
@@ -204,6 +205,11 @@ gst_wayland_sink_class_init (GstWaylandSinkClass * klass)
           "display name to connect to, if not supplied via the GstContext",
           NULL, G_PARAM_READWRITE | G_PARAM_STATIC_STRINGS));
 
+  g_object_class_install_property (gobject_class, PROP_XDG_SHELL,
+      g_param_spec_boolean ("xdg-shell", "Wayland Display xdg-shell protocol",
+          "Whether to use the XDG shell protocol for the display", TRUE,
+          G_PARAM_READWRITE | G_PARAM_CONSTRUCT | G_PARAM_STATIC_STRINGS));
+
   g_object_class_install_property (gobject_class, PROP_FULLSCREEN,
       g_param_spec_boolean ("fullscreen", "Fullscreen",
           "Whether the surface should be made fullscreen ", FALSE,
@@ -229,6 +235,11 @@ gst_wayland_sink_get_property (GObject * object,
       g_value_set_string (value, sink->display_name);
       GST_OBJECT_UNLOCK (sink);
       break;
+    case PROP_XDG_SHELL:
+      GST_OBJECT_LOCK (sink);
+      g_value_set_boolean (value, sink->use_xdg_shell);
+      GST_OBJECT_UNLOCK (sink);
+      break;
     case PROP_FULLSCREEN:
       GST_OBJECT_LOCK (sink);
       g_value_set_boolean (value, sink->fullscreen);
@@ -252,6 +263,11 @@ gst_wayland_sink_set_property (GObject * object,
       sink->display_name = g_value_dup_string (value);
       GST_OBJECT_UNLOCK (sink);
       break;
+    case PROP_XDG_SHELL:
+      GST_OBJECT_LOCK (sink);
+      sink->use_xdg_shell = g_value_get_boolean (value);
+      GST_OBJECT_UNLOCK (sink);
+      break;
     case PROP_FULLSCREEN:
       GST_OBJECT_LOCK (sink);
       sink->fullscreen = g_value_get_boolean (value);
@@ -675,7 +691,8 @@ gst_wayland_sink_show_frame (GstVideoSink * vsink, GstBuffer * buffer)
     if (!sink->window) {
       /* if we were not provided a window, create one ourselves */
       sink->window = gst_wl_window_new_toplevel (sink->display,
-          &sink->video_info, sink->fullscreen, &sink->render_lock);
+          &sink->video_info, sink->fullscreen, sink->use_xdg_shell,
+          &sink->render_lock);
     }
   }
 
diff --git a/ext/wayland/gstwaylandsink.h b/ext/wayland/gstwaylandsink.h
index be92fe7..e29b508 100644
--- a/ext/wayland/gstwaylandsink.h
+++ b/ext/wayland/gstwaylandsink.h
@@ -62,6 +62,7 @@ struct _GstWaylandSink
   GstVideoInfo video_info;
   gboolean fullscreen;
 
+  gboolean use_xdg_shell;
   gchar *display_name;
 
   gboolean redraw_pending;
diff --git a/ext/wayland/wldisplay.c b/ext/wayland/wldisplay.c
index 39782bc..50100da 100644
--- a/ext/wayland/wldisplay.c
+++ b/ext/wayland/wldisplay.c
@@ -90,6 +90,11 @@ gst_wl_display_finalize (GObject * gobject)
   if (self->shell)
     wl_shell_destroy (self->shell);
 
+#ifdef __XDG_SHELL_PROTOCOL
+  if(self->xdgshell)
+    zxdg_shell_v6_destroy(self->xdgshell);
+#endif
+
   if (self->compositor)
     wl_compositor_destroy (self->compositor);
 
@@ -142,7 +147,7 @@ gst_wl_display_roundtrip (GstWlDisplay * self)
 }
 
 static void
-shm_format (void *data, struct wl_shm *wl_shm, uint32_t format)
+shm_format (void *data, struct wl_shm *wl_shm, guint format)
 {
   GstWlDisplay *self = data;
 
@@ -155,7 +160,7 @@ static const struct wl_shm_listener shm_listener = {
 
 static void
 dmabuf_format (void *data, struct zwp_linux_dmabuf_v1 *zwp_linux_dmabuf,
-    uint32_t format)
+    guint format)
 {
   GstWlDisplay *self = data;
 
@@ -211,9 +216,21 @@ gst_wl_display_check_format_for_dmabuf (GstWlDisplay * display,
   return FALSE;
 }
 
+#ifdef __XDG_SHELL_PROTOCOL
+static void
+xdg_shell_ping(void *data, struct zxdg_shell_v6 *shell, uint32_t serial)
+{
+  zxdg_shell_v6_pong(shell, serial);
+}
+
+static const struct zxdg_shell_v6_listener xdg_shell_listener = {
+  xdg_shell_ping,
+};
+#endif
+
 static void
 registry_handle_global (void *data, struct wl_registry *registry,
-    uint32_t id, const char *interface, uint32_t version)
+    guint id, const char *interface, guint version)
 {
   GstWlDisplay *self = data;
 
@@ -225,6 +242,11 @@ registry_handle_global (void *data, struct wl_registry *registry,
         wl_registry_bind (registry, id, &wl_subcompositor_interface, 1);
   } else if (g_strcmp0 (interface, "wl_shell") == 0) {
     self->shell = wl_registry_bind (registry, id, &wl_shell_interface, 1);
+#ifdef __XDG_SHELL_PROTOCOL
+  } else if (g_strcmp0(interface, "zxdg_shell_v6") == 0) {
+    self->xdgshell = wl_registry_bind(registry, id, &zxdg_shell_v6_interface, 1);
+    zxdg_shell_v6_add_listener(self->xdgshell, &xdg_shell_listener, self);
+#endif
   } else if (g_strcmp0 (interface, "wl_shm") == 0) {
     self->shm = wl_registry_bind (registry, id, &wl_shm_interface, 1);
     wl_shm_add_listener (self->shm, &shm_listener, self);
@@ -353,6 +375,13 @@ gst_wl_display_new_existing (struct wl_display * display,
     g_warning ("Could not bind to zwp_linux_dmabuf_v1");
   }
 
+#ifdef __XDG_SHELL_PROTOCOL
+  if (!self->xdgshell) {
+    g_warning ("Wayland compositor is missing the ability to position video "
+        "on display - No Xdg shell present");
+  }
+#endif
+
   self->thread = g_thread_try_new ("GstWlDisplay", gst_wl_display_thread_run,
       self, &err);
   if (err) {
diff --git a/ext/wayland/wldisplay.h b/ext/wayland/wldisplay.h
index 7c89212..816c37d 100644
--- a/ext/wayland/wldisplay.h
+++ b/ext/wayland/wldisplay.h
@@ -26,6 +26,9 @@
 #include <wayland-client.h>
 #include "viewporter-client-protocol.h"
 #include "linux-dmabuf-unstable-v1-client-protocol.h"
+#ifdef __XDG_SHELL_PROTOCOL
+#include "xdg-shell-unstable-v6-client-protocol.h"
+#endif
 
 G_BEGIN_DECLS
 
@@ -52,6 +55,9 @@ struct _GstWlDisplay
   struct wl_compositor *compositor;
   struct wl_subcompositor *subcompositor;
   struct wl_shell *shell;
+#ifdef __XDG_SHELL_PROTOCOL
+  struct zxdg_shell_v6 *xdgshell;
+#endif
   struct wl_shm *shm;
   struct wp_viewporter *viewporter;
   struct zwp_linux_dmabuf_v1 *dmabuf;
diff --git a/ext/wayland/wlwindow.c b/ext/wayland/wlwindow.c
index 9ef8c32..345e877 100644
--- a/ext/wayland/wlwindow.c
+++ b/ext/wayland/wlwindow.c
@@ -35,16 +35,63 @@ G_DEFINE_TYPE (GstWlWindow, gst_wl_window, G_TYPE_OBJECT);
 
 static void gst_wl_window_finalize (GObject * gobject);
 
+#ifdef __XDG_SHELL_PROTOCOL
 static void
-handle_ping (void *data, struct wl_shell_surface *shell_surface,
+handle_xdg_surface_configure(void *data, struct zxdg_surface_v6 *surface,
     uint32_t serial)
+{
+  GstWlWindow *window = data;
+  zxdg_surface_v6_ack_configure(surface, serial);
+
+  g_mutex_lock (&window->configure_mutex);
+  window->configured = TRUE;
+  g_cond_signal (&window->configure_cond);
+  g_mutex_unlock (&window->configure_mutex);
+}
+
+static const struct zxdg_surface_v6_listener xdg_surface_listener = {
+  handle_xdg_surface_configure
+};
+
+static void
+handle_xdg_toplevel_configure(void *data, struct zxdg_toplevel_v6 *toplevel,
+		int32_t width, int32_t height, struct wl_array *states)
+{
+  GstWlWindow *window = data;
+
+  GST_DEBUG ("XDG toplevel got a \"configure\" event, [ %d, %d ].",
+      width, height);
+
+  if (width <= 0 || height <= 0)
+    return;
+
+  gst_wl_window_set_render_rectangle (window, 0, 0, width, height);
+}
+
+static void
+handle_xdg_toplevel_close(void *data, struct zxdg_toplevel_v6 *xdg_toplevel)
+{
+  GstWlWindow *window = data;
+
+  GST_DEBUG ("XDG toplevel got a \"close\" event.");
+}
+
+static const struct zxdg_toplevel_v6_listener xdg_toplevel_listener = {
+  handle_xdg_toplevel_configure,
+  handle_xdg_toplevel_close,
+};
+#endif
+
+static void
+handle_ping (void *data, struct wl_shell_surface *shell_surface,
+    guint serial)
 {
   wl_shell_surface_pong (shell_surface, serial);
 }
 
 static void
 handle_configure (void *data, struct wl_shell_surface *shell_surface,
-    uint32_t edges, int32_t width, int32_t height)
+    guint edges, int32_t width, int32_t height)
 {
   GstWlWindow *window = data;
 
@@ -79,6 +126,11 @@ gst_wl_window_class_init (GstWlWindowClass * klass)
 static void
 gst_wl_window_init (GstWlWindow * self)
 {
+#ifdef __XDG_SHELL_PROTOCOL
+  self->configured = TRUE;
+  g_cond_init (&self->configure_cond);
+  g_mutex_init (&self->configure_mutex);
+#endif
 }
 
 static void
@@ -86,6 +138,13 @@ gst_wl_window_finalize (GObject * gobject)
 {
   GstWlWindow *self = GST_WL_WINDOW (gobject);
 
+#ifdef __XDG_SHELL_PROTOCOL
+  if (self->xdg_toplevel)
+    zxdg_toplevel_v6_destroy(self->xdg_toplevel);
+  if (self->xdg_surface)
+    zxdg_surface_v6_destroy (self->xdg_surface);
+#endif
+
   if (self->shell_surface)
     wl_shell_surface_destroy (self->shell_surface);
 
@@ -117,6 +176,9 @@ gst_wl_window_new_internal (GstWlDisplay * display, GMutex * render_lock)
   window = g_object_new (GST_TYPE_WL_WINDOW, NULL);
   window->display = g_object_ref (display);
   window->render_lock = render_lock;
+#ifdef __XDG_SHELL_PROTOCOL
+  g_cond_init (&window->configure_cond);
+#endif
 
   window->area_surface = wl_compositor_create_surface (display->compositor);
   window->video_surface = wl_compositor_create_surface (display->compositor);
@@ -156,35 +218,95 @@ gst_wl_window_ensure_fullscreen (GstWlWindow * window, gboolean fullscreen)
   if (!window)
     return;
 
-  if (fullscreen)
-    wl_shell_surface_set_fullscreen (window->shell_surface,
-        WL_SHELL_SURFACE_FULLSCREEN_METHOD_SCALE, 0, NULL);
-  else
-    wl_shell_surface_set_toplevel (window->shell_surface);
+#ifdef __XDG_SHELL_PROTOCOL
+  if (window->xdg_surface && window->xdg_toplevel) {
+    if (fullscreen)
+      zxdg_toplevel_v6_set_fullscreen (window->xdg_toplevel, NULL);
+    else
+      zxdg_toplevel_v6_unset_fullscreen (window->xdg_toplevel);
+  } else
+#endif
+  if (window->shell_surface) {
+    if (fullscreen)
+      wl_shell_surface_set_fullscreen (window->shell_surface,
+          WL_SHELL_SURFACE_FULLSCREEN_METHOD_SCALE, 0, NULL);
+    else
+      wl_shell_surface_set_toplevel (window->shell_surface);
+  }
 }
 
 GstWlWindow *
 gst_wl_window_new_toplevel (GstWlDisplay * display, const GstVideoInfo * info,
-    gboolean fullscreen, GMutex * render_lock)
+    gboolean fullscreen, gboolean xdgshell, GMutex * render_lock)
 {
   GstWlWindow *window;
   gint width;
 
   window = gst_wl_window_new_internal (display, render_lock);
 
-  /* go toplevel */
-  window->shell_surface = wl_shell_get_shell_surface (display->shell,
-      window->area_surface);
+#ifdef __XDG_SHELL_PROTOCOL
+  gint64 timeout;
+  if (xdgshell && display->xdgshell) {
+    window->xdg_surface = zxdg_shell_v6_get_xdg_surface (display->xdgshell,
+        window->area_surface);
+
+    if (!window->xdg_surface) {
+      GST_ERROR ("Unable to get xdg_shell_surface");
+
+      g_object_unref (window);
+      return NULL;
+    }
+    zxdg_surface_v6_add_listener (window->xdg_surface, &xdg_surface_listener,
+        window);
+
+    window->xdg_toplevel = zxdg_surface_v6_get_toplevel(window->xdg_surface);
+    if (!window->xdg_toplevel) {
+      GST_ERROR ("Unable to get xdg_top_level_surface");
+
+      g_object_unref (window);
+      return NULL;
+    }
+    zxdg_toplevel_v6_add_listener(window->xdg_toplevel,
+        &xdg_toplevel_listener, window);
+
+    g_mutex_lock (&window->configure_mutex);
+    window->configured = FALSE;
+    g_mutex_unlock (&window->configure_mutex);
+
+    wl_surface_commit (window->area_surface);
+    wl_display_dispatch(display->display);
+    wl_display_roundtrip(display->display);
+
+    g_mutex_lock (&window->configure_mutex);
+    timeout = g_get_monotonic_time () + 100 * G_TIME_SPAN_MILLISECOND;
+    while (!window->configured) {
+      if (!g_cond_wait_until (&window->configure_cond, &window->configure_mutex,
+              timeout)) {
+        GST_WARNING ("The compositor did not send configure event.");
+      }
+    }
+    g_mutex_unlock (&window->configure_mutex);
+
+    gst_wl_window_ensure_fullscreen (window, fullscreen);
+    GST_INFO ("Using xdg_shell_surface");
+  } else
+#endif
+  if (display->shell) {
+    window->shell_surface = wl_shell_get_shell_surface (display->shell,
+        window->area_surface);
+
+    if (!window->shell_surface) {
+      GST_ERROR ("Unable to get wl_shell_surface");
+
+      g_object_unref (window);
+      return NULL;
+    }
 
-  if (window->shell_surface) {
     wl_shell_surface_add_listener (window->shell_surface,
         &shell_surface_listener, window);
     gst_wl_window_ensure_fullscreen (window, fullscreen);
-  } else {
-    GST_ERROR ("Unable to get wl_shell_surface");
 
-    g_object_unref (window);
-    return NULL;
+    GST_INFO ("Using wl_shell_surface");
   }
 
   /* set the initial size to be the same as the reported video size */
@@ -232,7 +354,12 @@ gst_wl_window_is_toplevel (GstWlWindow * window)
 {
   g_return_val_if_fail (window != NULL, FALSE);
 
-  return (window->shell_surface != NULL);
+  gboolean ret = FALSE;
+#ifdef __XDG_SHELL_PROTOCOL
+  if (window->xdg_toplevel != NULL)
+    ret = TRUE;
+#endif
+  return ((window->shell_surface != NULL) || ret);
 }
 
 static void
diff --git a/ext/wayland/wlwindow.h b/ext/wayland/wlwindow.h
index 10b49fd..9305deb 100644
--- a/ext/wayland/wlwindow.h
+++ b/ext/wayland/wlwindow.h
@@ -51,6 +51,13 @@ struct _GstWlWindow
   struct wl_subsurface *video_subsurface;
   struct wp_viewport *video_viewport;
   struct wl_shell_surface *shell_surface;
+#ifdef __XDG_SHELL_PROTOCOL
+  struct zxdg_surface_v6 *xdg_surface;
+  struct zxdg_toplevel_v6 *xdg_toplevel;
+  gboolean configured;
+  GCond configure_cond;
+  GMutex configure_mutex;
+#endif
 
   /* the size and position of the area_(sub)surface */
   GstVideoRectangle render_rectangle;
@@ -77,7 +84,8 @@ GType gst_wl_window_get_type (void);
 void gst_wl_window_ensure_fullscreen (GstWlWindow * window,
         gboolean fullscreen);
 GstWlWindow *gst_wl_window_new_toplevel (GstWlDisplay * display,
-        const GstVideoInfo * info, gboolean fullscreen, GMutex * render_lock);
+        const GstVideoInfo * info, gboolean fullscreen, gboolean xdgshell,
+        GMutex * render_lock);
 GstWlWindow *gst_wl_window_new_in_surface (GstWlDisplay * display,
         struct wl_surface * parent, GMutex * render_lock);
 
-- 
2.22.0

