From 216b7a64b75833b8da23bc85c33c93f47c67b813 Mon Sep 17 00:00:00 2001
From: Jean Xiao <jianxiao@codeaurora.org>
Date: Wed, 12 Jun 2019 17:00:03 +0800
Subject: [PATCH] meta-qti-gst: gstreamer 1.14.4 upgrade for SDM845

---
 config/bellagio/gstomx.conf | 18 ++++++++++++++++++
 configure.ac                |  2 +-
 omx/gstomxh265enc.c         | 29 +++++++++++++++++++++++++++++
 omx/gstomxh265enc.h         |  1 +
 4 files changed, 49 insertions(+), 1 deletion(-)

diff --git a/config/bellagio/gstomx.conf b/config/bellagio/gstomx.conf
index 7c5392f..2213a60 100644
--- a/config/bellagio/gstomx.conf
+++ b/config/bellagio/gstomx.conf
@@ -51,3 +51,21 @@ rank=0
 in-port-index=0
 out-port-index=1
 hacks=no-disable-outport
+
+[omxh265dec]
+type-name=GstOMXH265Dec
+core-name=/usr/lib/libOmxCore.so
+component-name=OMX.qcom.video.decoder.hevc
+rank=0
+in-port-index=0
+out-port-index=1
+hacks=no-disable-outport
+
+[omxh265enc]
+type-name=GstOMXH265Enc
+core-name=/usr/lib/libOmxCore.so
+component-name=OMX.qcom.video.encoder.hevc
+rank=0
+in-port-index=0
+out-port-index=1
+hacks=no-disable-outport
diff --git a/configure.ac b/configure.ac
index 0d29ee4..446a171 100644
--- a/configure.ac
+++ b/configure.ac
@@ -278,7 +278,7 @@ HAVE_IMAGE_EXT=no
 HAVE_OTHER_EXT=no
 if test "x$HAVE_EXTERNAL_OMX" = "xyes"; then
     AC_CHECK_HEADER([OMX_VideoExt.h], [HAVE_VIDEO_EXT=yes], [HAVE_VIDEO_EXT=no], [AC_INCLUDES_DEFAULT])
-    AC_CHECK_HEADER([OMX_IndexExt.h], [HAVE_INDEX_EXT=yes], [HAVE_INDEX_EXT=no], [AC_INCLUDES_DEFAULT])
+    AC_CHECK_HEADER([OMX_IndexExt.h], [HAVE_INDEX_EXT=yes], [HAVE_INDEX_EXT=no], [AC_INCLUDES_DEFAULT([#include "OMX_Core.h"])])
     AC_CHECK_HEADER([OMX_ComponentExt.h], [HAVE_COMPONENT_EXT=yes], [HAVE_COMPONENT_EXT=no], [AC_INCLUDES_DEFAULT])
     AC_CHECK_HEADER([OMX_CoreExt.h], [HAVE_CORE_EXT=yes], [HAVE_CORE_EXT=no], [AC_INCLUDES_DEFAULT])
     AC_CHECK_HEADER([OMX_AudioExt.h], [HAVE_AUDIO_EXT=yes], [HAVE_AUDIO_EXT=no], [AC_INCLUDES_DEFAULT])
diff --git a/omx/gstomxh265enc.c b/omx/gstomxh265enc.c
index 6076435..c2d947c 100644
--- a/omx/gstomxh265enc.c
+++ b/omx/gstomxh265enc.c
@@ -23,6 +23,7 @@
 #include "config.h"
 #endif

+#include <OMX_QCOMExtns.h>
 #include <gst/gst.h>

 #include "gstomxh265enc.h"
@@ -49,6 +50,7 @@ enum
   PROP_B_FRAMES,
   PROP_CONSTRAINED_INTRA_PREDICTION,
   PROP_LOOP_FILTER_MODE,
+  PROP_INLINESPSPPSHEADERS,
 };

 #define GST_OMX_H265_VIDEO_ENC_PERIODICITY_OF_IDR_FRAMES_DEFAULT    (0xffffffff)
@@ -56,6 +58,7 @@ enum
 #define GST_OMX_H265_VIDEO_ENC_B_FRAMES_DEFAULT (0xffffffff)
 #define GST_OMX_H265_VIDEO_ENC_CONSTRAINED_INTRA_PREDICTION_DEFAULT (FALSE)
 #define GST_OMX_H265_VIDEO_ENC_LOOP_FILTER_MODE_DEFAULT (0xffffffff)
+#define GST_OMX_H265_VIDEO_ENC_INLINE_SPS_PPS_HEADERS_DEFAULT TRUE

 #ifdef USE_OMX_TARGET_ZYNQ_USCALE_PLUS
 /* zynqultrascaleplus's OMX uses a param struct different of Android's one */
@@ -162,6 +165,14 @@ gst_omx_h265_enc_class_init (GstOMXH265EncClass * klass)
           GST_PARAM_MUTABLE_READY));
 #endif

+  g_object_class_install_property (gobject_class, PROP_INLINESPSPPSHEADERS,
+      g_param_spec_boolean ("inline-header",
+          "Inline SPS/PPS headers before IDR",
+          "Inline SPS/PPS header before IDR",
+          GST_OMX_H265_VIDEO_ENC_INLINE_SPS_PPS_HEADERS_DEFAULT,
+          G_PARAM_READWRITE | G_PARAM_STATIC_STRINGS |
+          GST_PARAM_MUTABLE_READY));
+
   videoenc_class->cdata.default_src_template_caps = "video/x-h265, "
       "width=(int) [ 1, MAX ], " "height=(int) [ 1, MAX ], "
       "framerate = (fraction) [0, MAX], "
@@ -186,6 +197,9 @@ gst_omx_h265_enc_set_property (GObject * object, guint prop_id,
     case PROP_INTERVALOFCODINGINTRAFRAMES:
       self->interval_intraframes = g_value_get_uint (value);
       break;
+    case PROP_INLINESPSPPSHEADERS:
+      self->inline_sps_pps_headers = g_value_get_boolean (value);
+      break;
 #ifdef USE_OMX_TARGET_ZYNQ_USCALE_PLUS
     case PROP_PERIODICITYOFIDRFRAMES:
       self->periodicity_idr = g_value_get_uint (value);
@@ -216,6 +230,9 @@ gst_omx_h265_enc_get_property (GObject * object, guint prop_id, GValue * value,
     case PROP_INTERVALOFCODINGINTRAFRAMES:
       g_value_set_uint (value, self->interval_intraframes);
       break;
+    case PROP_INLINESPSPPSHEADERS:
+      g_value_set_boolean (value, self->inline_sps_pps_headers);
+      break;
 #ifdef USE_OMX_TARGET_ZYNQ_USCALE_PLUS
     case PROP_PERIODICITYOFIDRFRAMES:
       g_value_set_uint (value, self->periodicity_idr);
@@ -241,6 +258,7 @@ gst_omx_h265_enc_init (GstOMXH265Enc * self)
 {
   self->interval_intraframes =
       GST_OMX_H265_VIDEO_ENC_INTERVAL_OF_CODING_INTRA_FRAMES_DEFAULT;
+  self->inline_sps_pps_headers = GST_OMX_H265_VIDEO_ENC_INLINE_SPS_PPS_HEADERS_DEFAULT;
 #ifdef USE_OMX_TARGET_ZYNQ_USCALE_PLUS
   self->periodicity_idr =
       GST_OMX_H265_VIDEO_ENC_PERIODICITY_OF_IDR_FRAMES_DEFAULT;
@@ -453,6 +471,17 @@ gst_omx_h265_enc_set_format (GstOMXVideoEnc * enc, GstOMXPort * port,
     set_intra_period (self);
 #endif

+  OMX_CONFIG_BOOLEANTYPE param;
+  GST_OMX_INIT_STRUCT(&param);
+
+  if (self->inline_sps_pps_headers) {
+      param.bEnabled = TRUE;
+  } else {
+      param.bEnabled = FALSE;
+  }
+  err = gst_omx_component_set_parameter (GST_OMX_VIDEO_ENC (self)->enc,
+      OMX_QcomIndexParamSequenceHeaderWithIDR, &param);
+
   gst_omx_port_get_port_definition (GST_OMX_VIDEO_ENC (self)->enc_out_port,
       &port_def);
   port_def.format.video.eCompressionFormat =
diff --git a/omx/gstomxh265enc.h b/omx/gstomxh265enc.h
index c53be18..5d00e5c 100644
--- a/omx/gstomxh265enc.h
+++ b/omx/gstomxh265enc.h
@@ -49,6 +49,7 @@ struct _GstOMXH265Enc

   /* properties */
   guint32 interval_intraframes;
+  gboolean inline_sps_pps_headers;
 #ifdef USE_OMX_TARGET_ZYNQ_USCALE_PLUS
   guint32 periodicity_idr;
   guint32 b_frames;
--
1.9.1

