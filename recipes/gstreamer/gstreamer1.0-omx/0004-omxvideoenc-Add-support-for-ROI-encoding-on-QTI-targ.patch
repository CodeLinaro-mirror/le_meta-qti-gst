 gio_dep = dependency('gio-2.0', version : glib_req)
 gmodule_dep = dependency('gmodule-2.0', version : glib_req)
+libmlmeta = cc.find_library('qtimlmeta', required : false)

 gst_omx_args = ['-DHAVE_CONFIG_H']
 configinc = include_directories('.')
diff --git a/omx/Makefile.am b/omx/Makefile.am
index 9f2f016..ae5c9ea 100644
--- a/omx/Makefile.am
+++ b/omx/Makefile.am
@@ -103,7 +103,8 @@ libgstomx_la_LIBADD = \
 	$(GST_BASE_LIBS) \
 	$(GST_LIBS) \
 	$(GST_ALLOCATORS_LIBS) \
-	$(GMODULE_NO_EXPORT_LIBS)
+	$(GMODULE_NO_EXPORT_LIBS) \
+	-lqtimlmeta
 libgstomx_la_LDFLAGS = $(GST_PLUGIN_LDFLAGS)

 if HAVE_GBM
diff --git a/omx/gstomxvideoenc.c b/omx/gstomxvideoenc.c
index 9f8ecc2..3b3c91f 100644
--- a/omx/gstomxvideoenc.c
+++ b/omx/gstomxvideoenc.c
@@ -36,6 +36,10 @@
 #include <OMX_Index.h>
 #endif

+#ifdef USE_OMX_TARGET_QTI
+#include <ml-meta/ml_meta.h>
+#endif
+
 GST_DEBUG_CATEGORY_STATIC (gst_omx_video_enc_debug_category);
 #define GST_CAT_DEFAULT gst_omx_video_enc_debug_category

@@ -74,6 +78,38 @@ gst_omx_video_enc_control_rate_get_type (void)
 }

 #ifdef USE_OMX_TARGET_QTI
+typedef enum
+{
+  GST_OMX_ROI_QUANT_DISABLED,
+  GST_OMX_ROI_QUANT_METADATA,
+  GST_OMX_ROI_QUANT_CUSTOM,
+} GstOMXVideoEncRoiQuantMode;
+
+#define GST_TYPE_OMX_VIDEO_ENC_ROI_QUANT_MODE (gst_omx_video_enc_roi_quant_mode_get_type ())
+static GType
+gst_omx_video_enc_roi_quant_mode_get_type (void)
+{
+  static GType qtype = 0;
+
+  if (qtype == 0) {
+    static const GEnumValue values[] = {
+      {GST_OMX_ROI_QUANT_DISABLED,
+            "Let the encoder change the QP for each coding unit according to its content",
+          "disabled"},
+      {GST_OMX_ROI_QUANT_METADATA,
+            "Adjust QP according to the regions of interest defined on each frame. Must be set to handle ROI metadata.",
+          "metadata"},
+      {GST_OMX_ROI_QUANT_CUSTOM,
+            "User defined ROI area via the 'roi-quant-area' property. The ROI metadata will be ignored",
+          "custom"},
+      {0, NULL, NULL}
+    };
+
+    qtype = g_enum_register_static ("GstOMXVideoEncRoiQuantMode", values);
+  }
+  return qtype;
+}
+
 #define GST_TYPE_OMX_VIDEO_ENC_HIER_CODING (gst_omx_video_enc_hier_coding_get_type ())
 static GType
 gst_omx_video_enc_hier_coding_get_type (void)
@@ -276,6 +312,10 @@ enum
   PROP_MAX_QUANT_P_FRAMES,
   PROP_MIN_QUANT_B_FRAMES,
   PROP_MAX_QUANT_B_FRAMES,
+  PROP_ROI_QUANT_MODE,
+  PROP_ROI_QUANT_DELTA,
+  PROP_ROI_QUANT_RECTANGLES,
+  PROP_ROI_QUANT_DELTA_METADATA,
   PROP_NUM_LTR_FRAMES,
   PROP_NUM_HIER_LAYERS,
   PROP_HIER_CODING,
@@ -319,6 +359,8 @@ enum
 #define GST_OMX_VIDEO_ENC_SLICE_SIZE_DEFAULT (0)
 #define GST_OMX_VIDEO_ENC_DEPENDENT_SLICE_DEFAULT (FALSE)
 #define GST_OMX_VIDEO_ENC_DEFAULT_ROI_QUALITY OMX_ALG_ROI_QUALITY_HIGH
+#define GST_OMX_VIDEO_ENC_ROI_QUANT_MODE_DEFAULT GST_OMX_ROI_QUANT_DISABLED
+#define GST_OMX_VIDEO_ENC_ROI_QUANT_DELTA_DEFAULT (-15)
 #define GST_OMX_VIDEO_ENC_NUM_LTR_FRAMES_DEFAULT (0xffffffff)
 #define GST_OMX_VIDEO_ENC_NUM_HIER_LAYERS_DEFAULT (0xffffffff)
