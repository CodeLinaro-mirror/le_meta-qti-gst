   G_OBJECT_CLASS (gst_omx_video_enc_parent_class)->finalize (object);
 }

@@ -1287,6 +1408,75 @@ gst_omx_video_enc_set_property (GObject * object, guint prop_id,
     case PROP_MAX_QUANT_B_FRAMES:
       self->max_quant_b_frames = g_value_get_uint (value);
       break;
+    case PROP_ROI_QUANT_MODE:
+      self->roi_quant_mode = g_value_get_enum (value);
+      break;
+    case PROP_ROI_QUANT_RECTANGLES:
+    {
+      guint idx = 0;
+
+      /* Remove all old values */
+      g_array_set_size (self->roi_quant_rectangles, 0);
+
+      for (idx = 0; idx < gst_value_array_get_size (value); idx++) {
+        const GValue *val = gst_value_array_get_value (value, idx);
+        GstVideoRectangle rectangle = { 0, 0, 0, 0 };
+
+        if (gst_value_array_get_size (val) != 4) {
+          GST_ERROR_OBJECT (self, "Invalid dimensions for ROI rectangle "
+              "at index '%u', ignoring", idx);
+          continue;
+        }
+
+        rectangle.x = g_value_get_int (gst_value_array_get_value (val, 0));
+        rectangle.y = g_value_get_int (gst_value_array_get_value (val, 1));
+        rectangle.w = g_value_get_int (gst_value_array_get_value (val, 2));
+        rectangle.h = g_value_get_int (gst_value_array_get_value (val, 3));
+
+        if (rectangle.w == 0 || rectangle.h == 0) {
+          GST_WARNING_OBJECT (self, "Invalid width and/or height for the "
+              "ROI rectangle at index %u, ignoring", idx);
+          continue;
+        }
+
+        g_array_append_val (self->roi_quant_rectangles, rectangle);
+      }
+      break;
+    }
+    case PROP_ROI_QUANT_DELTA:
+    {
+      guint idx = 0;
+      /* Remove all old values */
+      g_array_set_size (self->roi_quant_deltas, 0);
+
+      for (idx = 0; idx < gst_value_array_get_size (value); idx++) {
+        const int val = g_value_get_int (gst_value_array_get_value (value, idx));
+        g_array_append_val (self->roi_quant_deltas, val);
+      }
+      break;
+    }
+    case PROP_ROI_QUANT_DELTA_METADATA:
+    {
+      guint idx = 0;
+      gchar *object_name;
+      gint qp_delta;
+
+      for (idx = 0; idx < gst_value_array_get_size (value); idx++) {
+        const GValue *val = gst_value_array_get_value (value, idx);
+
+        if (gst_value_array_get_size (val) != 2) {
+          GST_ERROR_OBJECT (self, "Invalid dimensions for ML metadata object qp delta pair"
+              "at index '%u', ignoring", idx);
+          continue;
+        }
+
+        object_name = g_value_get_string (gst_value_array_get_value (val, 0));
+        qp_delta    = g_value_get_int (gst_value_array_get_value (val, 1));
+
+        g_hash_table_insert(self->roi_metadata_qp_delta_table, g_strdup(object_name), qp_delta);
+      }
+      break;
+    }
     case PROP_NUM_LTR_FRAMES:
       self->num_ltr_frames = g_value_get_uint (value);
       break;
@@ -1396,6 +1586,92 @@ gst_omx_video_enc_get_property (GObject * object, guint prop_id, GValue * value,
     case PROP_MAX_QUANT_B_FRAMES:
       g_value_set_uint (value, self->max_quant_b_frames);
       break;
+    case PROP_ROI_QUANT_MODE:
+      g_value_set_enum (value, self->roi_quant_mode);
+      break;
+    case PROP_ROI_QUANT_RECTANGLES:
+    {
+      GstVideoRectangle *rectangle = NULL;
+      guint idx = 0;
+
+      for (idx = 0; idx < self->roi_quant_rectangles->len; idx++) {
+        GValue element = G_VALUE_INIT, val = G_VALUE_INIT;
+
+        g_value_init (&element, GST_TYPE_ARRAY);
+        g_value_init (&val, G_TYPE_INT);
+
+        rectangle = &g_array_index (self->roi_quant_rectangles,
+            GstVideoRectangle, idx);
+
+        g_value_set_int (&val, rectangle->x);
+        gst_value_array_append_value (&element, &val);
+
+        g_value_set_int (&val, rectangle->y);
+        gst_value_array_append_value (&element, &val);
+
+        g_value_set_int (&val, rectangle->w);
+        gst_value_array_append_value (&element, &val);
+
+        g_value_set_int (&val, rectangle->h);
+        gst_value_array_append_value (&element, &val);
+
+        /* Append the rectangle to the output GST array */
+        gst_value_array_append_value (value, &element);
+
+        g_value_unset (&val);
+        g_value_unset (&element);
+      }
+      break;
+    }
+    case PROP_ROI_QUANT_DELTA:
+    {
+      guint idx = 0;
+      int *qp_delta_value = NULL;
+
+      for (idx = 0; idx < self->roi_quant_deltas->len; idx++) {
+        GValue val = G_VALUE_INIT;
+
+        g_value_init (&val, G_TYPE_INT);
+
+        qp_delta_value = &g_array_index (self->roi_quant_deltas,
+            int, idx);
+
+        g_value_set_int (&val, *qp_delta_value);
+
+        /* Append the QP delta value to the output GST array */
+        gst_value_array_append_value (value, &val);
+
+        g_value_unset (&val);
+      }
+      break;
+    }
+    case PROP_ROI_QUANT_DELTA_METADATA:
+    {
+      GHashTableIter iter;
+      gpointer key, hash_value;
+
+      g_hash_table_iter_init (&iter, self->roi_metadata_qp_delta_table);
+
+      while (g_hash_table_iter_next (&iter, &key, &hash_value))
+      {
+        /* do something with key and value */
+        GValue element = G_VALUE_INIT, val = G_VALUE_INIT;
+        g_value_init (&element, GST_TYPE_ARRAY);
+        g_value_init (&val, G_TYPE_STRING);
+
+        g_value_set_string (&val, (char)key);
+        gst_value_array_append_value (&element, &val);
+        g_value_set_int (&val, GPOINTER_TO_INT(hash_value));
+        gst_value_array_append_value (&element, &val);
+
+        /* Append the object_name qp_delta value pair to the output GST array */
+        gst_value_array_append_value (value, &element);
+
+        g_value_unset (&val);
+        g_value_unset (&element);
+      }
+      break;
+    }
     case PROP_NUM_LTR_FRAMES:
       g_value_set_uint (value, self->num_ltr_frames);
       break;
@@ -3029,6 +3305,124 @@ handle_roi_metadata (GstOMXVideoEnc * self, GstBuffer * input)
 }
 #endif

+#ifdef USE_OMX_TARGET_QTI
+static void
+handle_roi_metadata (GstOMXVideoEnc * self, GstBuffer * input)
+{
+  GSList *metalist = NULL, *list = NULL;
+  OMX_QTI_VIDEO_CONFIG_ROI_RECT_REGION_INFO roiparam;
+  int qp_delta_value = 0;
+
+  GST_OMX_INIT_STRUCT (&roiparam);
+
+  list = metalist = gst_buffer_get_detection_meta (input);
+
+  if (self->roi_quant_mode == GST_OMX_ROI_QUANT_DISABLED) {
+    // ROI mode is disable, nothing to do except to return immediately.
+    return;
+  } else if (self->roi_quant_mode == GST_OMX_ROI_QUANT_METADATA) {
+
+    if (NULL == metalist) {
+      GST_DEBUG_OBJECT (self, "No ML detection metadata found");
+      return;
+    }
+
+    while (list != NULL) {
+      GstMLDetectionMeta *meta = list->data;
+      GstMLClassificationResult *result = meta->box_info->data;
+
+      if (MAX_RECT_ROI_NUM == roiparam.nRegionNum) {
+        GST_WARNING_OBJECT (self,
+            "Received more than the allowed ROI, clipping to %d!",
+            MAX_RECT_ROI_NUM);
+        break;
+      }
+      // If user specifies some object_name qp_delta pair(s) perform lookup
+      if(g_hash_table_size(self->roi_metadata_qp_delta_table) != 0){
+
+        // Perform hash table look up if user specified object was detected.
+        // Returns the corresponding delta QP else will return 0.
+        qp_delta_value = GPOINTER_TO_INT(g_hash_table_lookup(
+            self->roi_metadata_qp_delta_table,result->name));
+
+      } else if(self->roi_quant_deltas->len == 1){
+        // Else if user just specifies roi-quant-delta apply one quant delta
+        qp_delta_value = g_array_index(self->roi_quant_deltas, int, 0);
+      }else if(self->roi_quant_deltas->len > 1){
+        GST_WARNING_OBJECT (self,
+        "More than one generic QP delta value given for metadata usecase.");
+      }
+
+      roiparam.nRegions[roiparam.nRegionNum].nLeft = meta->bounding_box.x;
+      roiparam.nRegions[roiparam.nRegionNum].nTop = meta->bounding_box.y;
+      roiparam.nRegions[roiparam.nRegionNum].nRight =
+          meta->bounding_box.x + meta->bounding_box.width;
+      roiparam.nRegions[roiparam.nRegionNum].nBottom =
+          meta->bounding_box.y + meta->bounding_box.height;
+      roiparam.nRegions[roiparam.nRegionNum].nDeltaQP = qp_delta_value;
+      roiparam.nRegionNum++;
+
+
+      GST_LOG_OBJECT (self, "ROI: name=%s confidence=%.2f (%d, %d) %dx%d",
+          result->name, result->confidence, meta->bounding_box.x,
+          meta->bounding_box.y, meta->bounding_box.width,
+          meta->bounding_box.height);
+
+      list = list->next;
+    }
+  } else if (self->roi_quant_mode == GST_OMX_ROI_QUANT_CUSTOM) {
+    GstVideoRectangle *rectangle = NULL;
+    guint idx = 0;
+
+    if (self->roi_quant_deltas->len != self->roi_quant_rectangles->len)
+    {
+      GST_ERROR_OBJECT(self,
+          "Number of QP Deltas provided does not match provided number of ROI");
+      return;
+    }
+
+    for (idx = 0; idx < self->roi_quant_rectangles->len; idx++) {
+      rectangle = &g_array_index (self->roi_quant_rectangles,
+          GstVideoRectangle, idx);
+
+      qp_delta_value = g_array_index(self->roi_quant_deltas, int, idx);
+
+      if (MAX_RECT_ROI_NUM == roiparam.nRegionNum) {
+        GST_WARNING_OBJECT (self,
+            "Received more than the allowed ROI, clipping to %d!",
+            MAX_RECT_ROI_NUM);
+        break;
+      }
+
+      roiparam.nRegions[roiparam.nRegionNum].nLeft = rectangle->x;
+      roiparam.nRegions[roiparam.nRegionNum].nTop = rectangle->y;
+      roiparam.nRegions[roiparam.nRegionNum].nRight =
+          rectangle->x + rectangle->w;
+      roiparam.nRegions[roiparam.nRegionNum].nBottom =
+          rectangle->y + rectangle->h;
+      roiparam.nRegions[roiparam.nRegionNum].nDeltaQP = qp_delta_value;
+      roiparam.nRegionNum++;
+
+      GST_LOG_OBJECT (self, "ROI: (%d, %d) %dx%d",
+          rectangle->x, rectangle->y, rectangle->w, rectangle->h);
+    }
+  }
+
+  if (metalist != NULL && self->roi_quant_mode != GST_OMX_ROI_QUANT_METADATA)
+    GST_WARNING_OBJECT (self,
+        "Need 'roi-quant-mode=metadata' to handle ROI metadata, ignoring!");
+
+  g_slist_free (metalist);
+
+  roiparam.nPortIndex = self->enc_in_port->index;
+  GST_OMX_SET_TICKS (roiparam.nTimeStamp,
+      gst_util_uint64_scale (input->pts, OMX_TICKS_PER_SECOND, GST_SECOND));
+
+  gst_omx_component_set_config (self->enc,
+      (OMX_INDEXTYPE) OMX_QTIIndexConfigVideoRoiRectRegionInfo, &roiparam);
+}
+#endif
+
 static GstFlowReturn
 gst_omx_video_enc_handle_frame (GstVideoEncoder * encoder,
