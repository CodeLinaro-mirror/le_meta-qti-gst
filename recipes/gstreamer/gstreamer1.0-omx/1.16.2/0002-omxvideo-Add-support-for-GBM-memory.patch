+#if defined (HAVE_GBM)
+static gboolean
+gst_omx_load_symbol (gpointer * method, gpointer handle, const gchar * name)
+{
+  *(method) = dlsym (handle, name);
+  if (NULL == *(method)) {
+    GST_ERROR ("Failed to link library method %s, error: %s", name, dlerror ());
+    return FALSE;
+  }
+  return TRUE;
+}
+
+static void
+gst_omx_close_gbm_module (GstOMXGBMModule * module)
+{
+  if (module == NULL)
+    return;
+
+  if (module->device != NULL) {
+    GST_INFO ("Closing GBM device %p", module->device);
+    module->device_destroy (module->device);
+  }
+  module->device = NULL;
+
+  if (module->devfd >= 0) {
+    GST_INFO ("Closing GBM device FD %d", module->devfd);
+    close (module->devfd);
+  }
+  module->devfd = -1;
+
+  if (module->libhandle != NULL) {
+    GST_INFO ("Closing GBM libhandle %p", module->libhandle);
+    dlclose (module->libhandle);
+  }
+  module->libhandle = NULL;
+
+  g_slice_free (GstOMXGBMModule, module);
+}
+
+static GstOMXGBMModule *
+gst_omx_open_gbm_module (void)
+{
+  GstOMXGBMModule *module = NULL;
+  gboolean success = TRUE;
+
+  if ((module = g_slice_new0 (GstOMXGBMModule)) == NULL) {
+    GST_ERROR ("Failed to allocate memory for GBM module!");
+    return NULL;
+  }
+
+  module->devfd = -1;
+
+  /* Load GBM library */
+  module->libhandle = dlopen ("libgbm.so", RTLD_NOW);
+  if (NULL == module->libhandle) {
+    GST_ERROR ("Failed to open GBM library, error: %s", dlerror ());
+    return NULL;
+  }
+
+  /* Load GBM library symbols */
+  success &= gst_omx_load_symbol ((gpointer *) & module->create_device,
+      module->libhandle, "gbm_create_device");
+  success &= gst_omx_load_symbol ((gpointer *) & module->device_destroy,
+      module->libhandle, "gbm_device_destroy");
+  success &= gst_omx_load_symbol ((gpointer *) & module->bo_import,
+      module->libhandle, "gbm_bo_import");
+  success &= gst_omx_load_symbol ((gpointer *) & module->bo_create,
+      module->libhandle, "gbm_bo_create");
+  success &= gst_omx_load_symbol ((gpointer *) & module->bo_destroy,
+      module->libhandle, "gbm_bo_destroy");
+  success &= gst_omx_load_symbol ((gpointer *) & module->bo_get_fd,
+      module->libhandle, "gbm_bo_get_fd");
+  success &= gst_omx_load_symbol ((gpointer *) & module->perform,
+      module->libhandle, "gbm_perform");
+
+  if (!success) {
+    gst_omx_close_gbm_module (module);
+    return NULL;
+  }
+
+  module->devfd = open ("/dev/dri/card0", O_RDWR);
+  if (module->devfd < 0) {
+    GST_WARNING ("Falling back to /dev/ion");
+    module->devfd = open ("/dev/ion", O_RDWR);
+  }
+
+  if (module->devfd < 0) {
+    GST_ERROR ("Failed to open device FD!");
+    gst_omx_close_gbm_module (module);
+    return NULL;
+  }
+
+  GST_INFO ("Opened GBM device FD %d", module->devfd);
+
+  module->device = module->create_device (module->devfd);
+  if (NULL == module->device) {
+    GST_ERROR ("Failed to create GBM device!");
+    gst_omx_close_gbm_module (module);
+    return NULL;
+  }
+
+  GST_INFO ("Created GBM handle %p", module->device);
+  return module;
+}
+#endif // HAVE_GBM
+
+gboolean
+gst_omx_caps_has_feature (const GstCaps * caps, const gchar * feature)
+{
+  guint idx = 0;
+
+  while (idx != gst_caps_get_size (caps)) {
+    GstCapsFeatures *const features = gst_caps_get_features (caps, idx);
+
+    // Skip ANY caps and return immediately if feature is present.
+    if (!gst_caps_features_is_any (features) &&
+        gst_caps_features_contains (features, feature))
+      return TRUE;
+
+    idx++;
+  }
+  return FALSE;
+}
+
+gboolean
+gst_omx_caps_has_compression (const GstCaps * caps, const gchar * compression)
+{
+  GstStructure *structure = NULL;
+  const gchar *string = NULL;
+
+  structure = gst_caps_get_structure (caps, 0);
+  string = gst_structure_has_field (structure, "compression") ?
+      gst_structure_get_string (structure, "compression") : NULL;
+
+  return (g_strcmp0 (string, compression) == 0) ? TRUE : FALSE;
+}
