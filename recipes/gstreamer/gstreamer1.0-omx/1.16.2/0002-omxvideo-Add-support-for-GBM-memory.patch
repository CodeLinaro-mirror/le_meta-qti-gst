   GST_OBJECT_LOCK (pool);
 
-  if (!gst_buffer_pool_config_get_params (config, &caps, &size, &min, NULL))
+  if (!gst_buffer_pool_config_get_params (config, &caps, &size, &min, &max))
     goto wrong_config;
 
   if (caps == NULL)
@@ -359,7 +360,60 @@ gst_omx_buffer_pool_set_config (GstBufferPool * bpool, GstStructure * config)
         gst_buffer_pool_config_has_option (config,
         GST_BUFFER_POOL_OPTION_VIDEO_META);
 
+    info.size = MAX (size, info.size);
+
+    // GBM library has its own alignment for the allocated buffers so update
+    // the size, stride and offset for the buffer planes in the video info.
+    if (pool->output_mode == GST_OMX_BUFFER_MODE_GBM) {
+#if defined (HAVE_GBM) && defined (USE_OMX_TARGET_QTI)
+      struct gbm_buf_info bufinfo = { 0, };
