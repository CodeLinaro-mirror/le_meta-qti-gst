@@ -2671,6 +2826,31 @@ gst_omx_port_use_dynamic_buffers (GstOMXPort * port)
   return err;
 }
 
+/* Internally, we introduced a custom dynamic allocation mode where only buffer metadata
+ * is alloacted in the OMX headers instead of actual buffer. The actual buffers
+ * are allocated upstream and passed to OMX by setting the pBuffer dynamically
+ * for each input buffer.
+ *
+ * This function takes care of allocating the buffer headers. Element should
+ * then use one of the gst_omx_buffer_import_gbm_buffer() method to update
+ * buffer's pBuffer pointers for each incoming buffer.
+ *
+ * NOTE: Uses comp->lock and comp->messages_lock */
+OMX_ERRORTYPE
+gst_omx_port_allocate_dynamic_buffers (GstOMXPort * port)
+{
+  OMX_ERRORTYPE err;
+
+  g_return_val_if_fail (port != NULL, OMX_ErrorUndefined);
+
+  g_mutex_lock (&port->comp->lock);
+  err = gst_omx_port_allocate_buffers_unlocked (port, NULL, NULL, -1);
+  port->allocation = GST_OMX_BUFFER_ALLOCATION_USE_BUFFER_DYNAMIC;
+  g_mutex_unlock (&port->comp->lock);
+
+  return err;
+}
+
 /* gst_omx_buffer_map_* methods are used in dynamic buffer mode to map
  * a frame/memory/buffer and update @buffer so its pBuffer points to the
  * mapped data. It also ensures that the input will stay alive until
@@ -2748,6 +2928,65 @@ gst_omx_buffer_import_fd (GstOMXBuffer * buffer, GstBuffer * input)
   return TRUE;
 }
 
+gboolean
+gst_omx_buffer_import_gbm_buffer (GstOMXBuffer * buffer, GstBuffer * input)
+{
+  gint fd;
+  GstMemory *mem;
+#if defined (HAVE_GBM) && defined (USE_OMX_TARGET_QTI)
+  struct VideoGrallocMetadata *meta = NULL;
+  struct gbm_import_fd_data bufinfo = { 0, };
+#endif
+
+  g_return_val_if_fail (buffer != NULL, FALSE);
+  g_return_val_if_fail (input != NULL, FALSE);
+  g_return_val_if_fail (!buffer->input_frame_mapped, FALSE);
+  g_return_val_if_fail (!buffer->input_mem, FALSE);
+  g_return_val_if_fail (!buffer->input_buffer, FALSE);
+  g_return_val_if_fail (!buffer->input_buffer_mapped, FALSE);
+
+  mem = gst_buffer_peek_memory (input, 0);
+  g_return_val_if_fail (gst_is_fd_memory (mem), FALSE);
+
+  fd = gst_fd_memory_get_fd (mem);
+
+  buffer->input_buffer = gst_buffer_ref (input);
+
+#if defined (HAVE_GBM) && defined (USE_OMX_TARGET_QTI)
+  buffer->omx_buf->nAllocLen = sizeof (struct VideoGrallocMetadata);
+  buffer->omx_buf->nFilledLen = buffer->omx_buf->nAllocLen;
+
+  bufinfo.fd = fd;
+  bufinfo.width = buffer->port->port_def.format.video.nFrameWidth;
+  bufinfo.height = buffer->port->port_def.format.video.nFrameHeight;
+
+  switch (buffer->port->port_def.format.video.eColorFormat) {
+      /* Formats defined in extensions have their own enum so disable to -Wswitch warning */
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wswitch"
+    case QOMX_COLOR_FORMATYUV420PackedSemiPlanar32m:
+      bufinfo.format = GBM_FORMAT_YCbCr_420_SP_VENUS;
+      break;
+    case QOMX_COLOR_FORMATYUV420PackedSemiPlanar32mCompressed:
+      bufinfo.format = GBM_FORMAT_YCbCr_420_SP_VENUS_UBWC;
+      break;
+#pragma GCC diagnostic pop
+    default:
+      GST_ERROR ("Unsupported format: %x",
+          buffer->port->port_def.format.video.eColorFormat);
+      return FALSE;
+  }
+
+  meta = (struct VideoGrallocMetadata *) buffer->omx_buf->pBuffer;
+  meta->eType = kMetadataBufferTypeGrallocSource;
+  meta->pHandle =
+      buffer->port->comp->gbm->bo_import (buffer->port->comp->gbm->device,
+      GBM_BO_IMPORT_FD, &bufinfo, GBM_BO_USAGE_VIDEO_ENCODER_QTI);
+#endif
+
+  return TRUE;
+}
+
 gboolean
 gst_omx_buffer_map_buffer (GstOMXBuffer * buffer, GstBuffer * input)
 {
@@ -2842,6 +3081,18 @@ gst_omx_port_deallocate_buffers_unlocked (GstOMXPort * port)
       GST_DEBUG_OBJECT (comp->parent, "%s: deallocating buffer %p (%p)",
           comp->name, buf, buf->omx_buf->pBuffer);
 
+#if defined (HAVE_GBM) && defined (USE_OMX_TARGET_QTI)
+      // Release any imported GBM buffers on the input port.
+      if (port->port_def.eDir == OMX_DirInput &&
+          port->allocation = GST_OMX_BUFFER_ALLOCATION_USE_BUFFER_DYNAMIC) {
+        struct VideoGrallocMetadata *meta =
+            (struct VideoGrallocMetadata *) buf->omx_buf->pBuffer;
+
+        if (meta->pHandle != NULL)
+          port->comp->gbm->bo_destroy (meta->pHandle);
+      }
+#endif
+
       tmp = OMX_FreeBuffer (comp->handle, port->index, buf->omx_buf);
 
       if (tmp != OMX_ErrorNone) {
@@ -3405,6 +3656,34 @@ gst_omx_port_set_dmabuf (GstOMXPort * port, gboolean dmabuf)
 #endif
 }
 
+gboolean
+gst_omx_port_set_gbm (GstOMXPort * port, gboolean gbm)
+{
+#if defined (HAVE_GBM) && defined (USE_OMX_TARGET_QTI)
+  struct StoreMetaDataInBuffersParams buffer_mode;
+  OMX_ERRORTYPE err;
+
+  GST_OMX_INIT_STRUCT (&buffer_mode);
+  buffer_mode.nPortIndex = port->index;
+  buffer_mode.bStoreMetaData = gbm ? OMX_TRUE : OMX_FALSE;
+
+  err =
+      gst_omx_component_set_parameter (port->comp,
+      (OMX_INDEXTYPE) OMX_QcomIndexParamVideoMetaBufferMode, &buffer_mode);
+  if (err != OMX_ErrorNone) {
+    GST_WARNING_OBJECT (port->comp->parent,
+        "Failed to set port %d in %smetadata mode: %s (0x%08x)",
+        port->index, gbm ? "" : "non-", gst_omx_error_to_string (err), err);
+    return FALSE;
+  }
+
+  return TRUE;
+#else
+  /* gbm metadata not supported for this platform */
+  return FALSE;
+#endif
+}
