From f4531e267bc2fa089d6a9c84e278eac892175549 Mon Sep 17 00:00:00 2001
From: "Petar G. Georgiev" <petarg@codeaurora.org>
Date: Fri, 15 May 2020 07:46:24 +0100
Subject: [PATCH] omxh265enc: Add support for prepending SPSPPS to IDR frames

---
 omx/gstomxh265enc.c | 54 +++++++++++++++++++++++++++++++++++++++++++++
 omx/gstomxh265enc.h |  3 +++
 2 files changed, 57 insertions(+)

diff --git a/omx/gstomxh265enc.c b/omx/gstomxh265enc.c
index 6076435..e9d7caa 100644
--- a/omx/gstomxh265enc.c
+++ b/omx/gstomxh265enc.c
@@ -49,6 +49,9 @@ enum
   PROP_B_FRAMES,
   PROP_CONSTRAINED_INTRA_PREDICTION,
   PROP_LOOP_FILTER_MODE,
+#ifdef USE_OMX_TARGET_QTI
+  PROP_INLINESPSPPSHEADERS,
+#endif
 };
 
 #define GST_OMX_H265_VIDEO_ENC_PERIODICITY_OF_IDR_FRAMES_DEFAULT    (0xffffffff)
@@ -56,6 +59,9 @@ enum
 #define GST_OMX_H265_VIDEO_ENC_B_FRAMES_DEFAULT (0xffffffff)
 #define GST_OMX_H265_VIDEO_ENC_CONSTRAINED_INTRA_PREDICTION_DEFAULT (FALSE)
 #define GST_OMX_H265_VIDEO_ENC_LOOP_FILTER_MODE_DEFAULT (0xffffffff)
+#ifdef USE_OMX_TARGET_QTI
+#define GST_OMX_H265_VIDEO_ENC_INLINE_SPS_PPS_HEADERS_DEFAULT      TRUE
+#endif
 
 #ifdef USE_OMX_TARGET_ZYNQ_USCALE_PLUS
 /* zynqultrascaleplus's OMX uses a param struct different of Android's one */
@@ -162,6 +168,16 @@ gst_omx_h265_enc_class_init (GstOMXH265EncClass * klass)
           GST_PARAM_MUTABLE_READY));
 #endif
 
+#ifdef USE_OMX_TARGET_QTI
+  g_object_class_install_property (gobject_class, PROP_INLINESPSPPSHEADERS,
+      g_param_spec_boolean ("inline-header",
+          "Inline SPS/PPS headers before IDR",
+          "Inline SPS/PPS header before IDR",
+          GST_OMX_H265_VIDEO_ENC_INLINE_SPS_PPS_HEADERS_DEFAULT,
+          G_PARAM_READWRITE | G_PARAM_STATIC_STRINGS |
+          GST_PARAM_MUTABLE_READY));
+#endif
+
   videoenc_class->cdata.default_src_template_caps = "video/x-h265, "
       "width=(int) [ 1, MAX ], " "height=(int) [ 1, MAX ], "
       "framerate = (fraction) [0, MAX], "
@@ -199,6 +215,11 @@ gst_omx_h265_enc_set_property (GObject * object, guint prop_id,
     case PROP_LOOP_FILTER_MODE:
       self->loop_filter_mode = g_value_get_enum (value);
       break;
+#endif
+#ifdef USE_OMX_TARGET_QTI
+    case PROP_INLINESPSPPSHEADERS:
+      self->inline_sps_pps_headers = g_value_get_boolean (value);
+      break;
 #endif
     default:
       G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
@@ -229,6 +250,11 @@ gst_omx_h265_enc_get_property (GObject * object, guint prop_id, GValue * value,
     case PROP_LOOP_FILTER_MODE:
       g_value_set_enum (value, self->loop_filter_mode);
       break;
+#endif
+#ifdef USE_OMX_TARGET_QTI
+    case PROP_INLINESPSPPSHEADERS:
+      g_value_set_boolean (value, self->inline_sps_pps_headers);
+      break;
 #endif
     default:
       G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
@@ -249,6 +275,10 @@ gst_omx_h265_enc_init (GstOMXH265Enc * self)
       GST_OMX_H265_VIDEO_ENC_CONSTRAINED_INTRA_PREDICTION_DEFAULT;
   self->loop_filter_mode = GST_OMX_H265_VIDEO_ENC_LOOP_FILTER_MODE_DEFAULT;
 #endif
+#ifdef USE_OMX_TARGET_QTI
+  self->inline_sps_pps_headers =
+      GST_OMX_H265_VIDEO_ENC_INLINE_SPS_PPS_HEADERS_DEFAULT;
+#endif
 }
 
 /* Update OMX_VIDEO_PARAM_PROFILELEVELTYPE.{eProfile,eLevel}
@@ -447,6 +477,30 @@ gst_omx_h265_enc_set_format (GstOMXVideoEnc * enc, GstOMXPort * port,
   OMX_VIDEO_HEVCPROFILETYPE profile = OMX_VIDEO_HEVCProfileUnknown;
   OMX_VIDEO_HEVCLEVELTYPE level = OMX_VIDEO_HEVCLevelUnknown;
 
+#ifdef USE_OMX_TARGET_QTI
+  {
+    // TODO Should be PrependSPSPPSToIDRFramesParams but the struct is defined
+    // in HardwareAPI.h which is C++ header and can not be included here.
+    OMX_CONFIG_BOOLEANTYPE prepend_sps_pps_headers;
+    GST_OMX_INIT_STRUCT(&prepend_sps_pps_headers);
+
+    if (self->inline_sps_pps_headers) {
+      prepend_sps_pps_headers.bEnabled = TRUE;
+    } else {
+      prepend_sps_pps_headers.bEnabled = FALSE;
+    }
+    err =
+        gst_omx_component_set_parameter (GST_OMX_VIDEO_ENC (self)->enc,
+        OMX_QcomIndexParamSequenceHeaderWithIDR, &prepend_sps_pps_headers);
+    if (err != OMX_ErrorNone) {
+      GST_ERROR_OBJECT (self,
+          "can't set OMX_QcomIndexParamSequenceHeaderWithIDR %s (0x%08x)",
+          gst_omx_error_to_string (err), err);
+      return FALSE;
+    }
+  }
+#endif
+
 #ifdef USE_OMX_TARGET_ZYNQ_USCALE_PLUS
   if (self->periodicity_idr !=
       GST_OMX_H265_VIDEO_ENC_PERIODICITY_OF_IDR_FRAMES_DEFAULT)
diff --git a/omx/gstomxh265enc.h b/omx/gstomxh265enc.h
index c53be18..bf13e47 100644
--- a/omx/gstomxh265enc.h
+++ b/omx/gstomxh265enc.h
@@ -55,6 +55,9 @@ struct _GstOMXH265Enc
   gboolean constrained_intra_prediction;
   guint32 loop_filter_mode;
 #endif
+#ifdef USE_OMX_TARGET_QTI
+  gboolean inline_sps_pps_headers;
+#endif
 };
 
 struct _GstOMXH265EncClass
-- 
2.17.1

