From 42cd991c77219641dba4901f6cd4ce0b85a12c6a Mon Sep 17 00:00:00 2001
From: Jean Xiao <jianxiao@codeaurora.org>
Date: Thu, 8 Aug 2019 16:21:38 +0800
Subject: [PATCH] omx: Fix PortSettingsChanged event

---
 omx/gstomx.c | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/omx/gstomx.c b/omx/gstomx.c
index d7181bf..222a255 100644
--- a/omx/gstomx.c
+++ b/omx/gstomx.c
@@ -569,9 +569,18 @@ EventHandler (OMX_HANDLETYPE hComponent, OMX_PTR pAppData, OMX_EVENTTYPE eEvent,
     }
     case OMX_EventPortSettingsChanged:
     {
-      GstOMXMessage *msg = g_slice_new (GstOMXMessage);
+      GstOMXMessage *msg;
       OMX_U32 index;
 
+#ifdef USE_OMX_TARGET_QTI
+      if (nData2 == OMX_IndexConfigCommonOutputCrop ||
+          nData2 == OMX_QTIIndexConfigDescribeColorAspects) {
+        GST_DEBUG_OBJECT (comp->parent, "%s ignore OMX_EventPortSettingsChanged"
+            " index 0x%08x (port index: %u)", comp->name, nData2, nData1);
+        break;
+      }
+#endif
+
       if (!(comp->hacks &
               GST_OMX_HACK_EVENT_PORT_SETTINGS_CHANGED_NDATA_PARAMETER_SWAP)) {
         index = nData1;
@@ -579,13 +588,12 @@ EventHandler (OMX_HANDLETYPE hComponent, OMX_PTR pAppData, OMX_EVENTTYPE eEvent,
         index = nData2;
       }
 
-
       if (index == 0
           && (comp->hacks &
               GST_OMX_HACK_EVENT_PORT_SETTINGS_CHANGED_PORT_0_TO_1))
         index = 1;
 
-
+      msg = g_slice_new (GstOMXMessage);
       msg->type = GST_OMX_MESSAGE_PORT_SETTINGS_CHANGED;
       msg->content.port_settings_changed.port = index;
       GST_DEBUG_OBJECT (comp->parent, "%s settings changed (port index: %u)",
-- 
2.17.1

