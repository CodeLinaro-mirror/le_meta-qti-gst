@@ -491,6 +539,10 @@ gboolean          gst_omx_buffer_map_memory (GstOMXBuffer * buffer, GstMemory *
 gboolean          gst_omx_buffer_map_buffer (GstOMXBuffer * buffer, GstBuffer * input);
