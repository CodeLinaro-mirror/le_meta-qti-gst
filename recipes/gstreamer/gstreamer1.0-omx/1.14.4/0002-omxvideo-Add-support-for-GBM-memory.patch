@@ -1886,6 +2035,12 @@ gst_omx_is_dynamic_allocation_supported (void)
   return TRUE;
 #endif
 
+  /* The internal stack does not implement OMX 1.2.0 but supports its custom dynamic
+   * allocation mode. */
