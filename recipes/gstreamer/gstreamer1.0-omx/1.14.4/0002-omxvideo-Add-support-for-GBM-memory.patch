+#ifdef HAVE_GBM
+typedef struct _GstOMXGBMModule GstOMXGBMModule;
+struct _GstOMXGBMModule {
+  // Either GBM device FD.
+  gint devfd;
+
+  // GBM library handle;
+  gpointer libhandle;
+  // GBM device handle;
+  struct gbm_device *device;
+
+  // GBM library APIs
+  struct gbm_device * (*create_device) (gint fd);
+  void (*device_destroy)(struct gbm_device * gbm);
+  struct gbm_bo * (*bo_import) (struct gbm_device * gbm, guint type,
