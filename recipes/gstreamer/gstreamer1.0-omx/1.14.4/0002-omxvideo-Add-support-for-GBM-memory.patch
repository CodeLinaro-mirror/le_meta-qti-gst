diff --git a/omx/gstomxbufferpool.c b/omx/gstomxbufferpool.c
index 2d6923e..b267aab 100644
--- a/omx/gstomxbufferpool.c
+++ b/omx/gstomxbufferpool.c
@@ -26,8 +26,13 @@
 
 #include "gstomxbufferpool.h"
 
+#include <gst/allocators/gstfdmemory.h>
 #include <gst/allocators/gstdmabuf.h>
 
+#if defined (HAVE_GBM) && defined (USE_OMX_TARGET_QTI)
+#include <media/msm_media_info.h>
+#endif
+
 GST_DEBUG_CATEGORY_STATIC (gst_omx_buffer_pool_debug_category);
 #define GST_CAT_DEFAULT gst_omx_buffer_pool_debug_category
 GST_DEBUG_CATEGORY_STATIC (CAT_PERFORMANCE);
@@ -283,10 +288,11 @@ gst_omx_buffer_pool_set_config (GstBufferPool * bpool, GstStructure * config)
 {
   GstOMXBufferPool *pool = GST_OMX_BUFFER_POOL (bpool);
   GstCaps *caps;
+  guint size, min, max;
 
   GST_OBJECT_LOCK (pool);
 
-  if (!gst_buffer_pool_config_get_params (config, &caps, NULL, NULL, NULL))
+  if (!gst_buffer_pool_config_get_params (config, &caps, &size, &min, &max))
     goto wrong_config;
 
   if (caps == NULL)
@@ -306,7 +312,60 @@ gst_omx_buffer_pool_set_config (GstBufferPool * bpool, GstStructure * config)
         gst_buffer_pool_config_has_option (config,
         GST_BUFFER_POOL_OPTION_VIDEO_META);
 
+    info.size = MAX (size, info.size);
+
+    // GBM library has its own alignment for the allocated buffers so update
+    // the size, stride and offset for the buffer planes in the video info.
+    if (pool->output_mode == GST_OMX_BUFFER_MODE_GBM) {
+#if defined (HAVE_GBM) && defined (USE_OMX_TARGET_QTI)
+      struct gbm_buf_info bufinfo = { 0, };
+      guint idx = 0, stride = 0, scanline = 0, usage = 0;
+      gboolean isubwc = gst_omx_caps_has_compression (caps, "ubwc");
+
+      bufinfo.width = GST_VIDEO_INFO_WIDTH (&info);
+      bufinfo.height = GST_VIDEO_INFO_HEIGHT (&info);
+
+      switch (GST_VIDEO_INFO_FORMAT (&info)) {
+        case GST_VIDEO_FORMAT_NV12:
+          bufinfo.format = GBM_FORMAT_NV12;
+          break;
+        default:
+          GST_WARNING_OBJECT (pool, "invalid video format: %s",
+              gst_video_format_to_string (GST_VIDEO_INFO_FORMAT (&info)));
+          goto wrong_video_caps;
+      }
+
+      usage |= isubwc ? GBM_BO_USAGE_UBWC_ALIGNED_QTI : 0;
+
+      pool->component->gbm->perform (GBM_PERFORM_GET_BUFFER_SIZE_DIMENSIONS,
+          &bufinfo, usage, &stride, &scanline, &size);
+
+      for (idx = 0; idx < GST_VIDEO_INFO_N_PLANES (&info); ++idx) {
+        GST_VIDEO_INFO_PLANE_STRIDE (&info, idx) = stride;
+        GST_VIDEO_INFO_PLANE_OFFSET (&info, idx) = idx * stride * scanline;
+
+        /* For UBWC formats there is very specific UV plane offset. */
+        if ((idx == 1) && isubwc && (bufinfo.format = GBM_FORMAT_NV12)) {
+          guint metastride = 0, metascanline = 0;
+
