+  struct gbm_bo * (*bo_create) (struct gbm_device * gbm, guint width,
+                                guint height, guint format, guint flags);
+  void (*bo_destroy) (struct gbm_bo * bo);
+  gint (*bo_get_fd) (struct gbm_bo *bo);
+  gint (*perform) (int operation,...);
+
+};
+#endif
