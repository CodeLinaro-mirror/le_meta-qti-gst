+          G_PARAM_READWRITE | G_PARAM_STATIC_STRINGS |
+          GST_PARAM_MUTABLE_READY));
+#endif
+
 #ifdef USE_OMX_TARGET_ZYNQ_USCALE_PLUS
   g_object_class_install_property (gobject_class, PROP_PERIODICITYOFIDRFRAMES,
       g_param_spec_uint ("periodicity-idr", "IDR periodicity",
@@ -194,6 +212,14 @@ gst_omx_h265_enc_set_property (GObject * object, guint prop_id,
     case PROP_INTERVALOFCODINGINTRAFRAMES:
       self->interval_intraframes = g_value_get_uint (value);
       break;
+#ifdef USE_OMX_TARGET_QTI
+    case PROP_PERIODICITYOFIDRFRAMES:
+      self->periodicity_idr = g_value_get_uint (value);
+      break;
+    case PROP_B_FRAMES:
+      self->b_frames = g_value_get_uint (value);
+      break;
+#endif
 #ifdef USE_OMX_TARGET_ZYNQ_USCALE_PLUS
     case PROP_PERIODICITYOFIDRFRAMES:
       self->periodicity_idr = g_value_get_uint (value);
@@ -227,6 +253,14 @@ gst_omx_h265_enc_get_property (GObject * object, guint prop_id, GValue * value,
     case PROP_INTERVALOFCODINGINTRAFRAMES:
       g_value_set_uint (value, self->interval_intraframes);
       break;
+#ifdef USE_OMX_TARGET_QTI
+    case PROP_PERIODICITYOFIDRFRAMES:
+      g_value_set_uint (value, self->periodicity_idr);
+      break;
+    case PROP_B_FRAMES:
+      g_value_set_uint (value, self->b_frames);
+      break;
+#endif
 #ifdef USE_OMX_TARGET_ZYNQ_USCALE_PLUS
     case PROP_PERIODICITYOFIDRFRAMES:
       g_value_set_uint (value, self->periodicity_idr);
@@ -255,6 +289,11 @@ gst_omx_h265_enc_init (GstOMXH265Enc * self)
 {
   self->interval_intraframes =
       GST_OMX_H265_VIDEO_ENC_INTERVAL_OF_CODING_INTRA_FRAMES_DEFAULT;
+#ifdef USE_OMX_TARGET_QTI
+  self->periodicity_idr =
+      GST_OMX_H265_VIDEO_ENC_PERIODICITY_OF_IDR_FRAMES_DEFAULT;
+  self->b_frames = GST_OMX_H265_VIDEO_ENC_B_FRAMES_DEFAULT;
+#endif
 #ifdef USE_OMX_TARGET_ZYNQ_USCALE_PLUS
   self->periodicity_idr =
       GST_OMX_H265_VIDEO_ENC_PERIODICITY_OF_IDR_FRAMES_DEFAULT;
@@ -417,9 +456,114 @@ update_param_hevc (GstOMXH265Enc * self,
     return FALSE;
   }
 
+/*QTI GOP pattern*/
+#ifdef USE_OMX_TARGET_QTI
+  QOMX_VIDEO_INTRAPERIODTYPE intra;
+  GST_OMX_INIT_STRUCT(&intra);
+  intra.nPortIndex = GST_OMX_VIDEO_ENC (self)->enc_out_port->index;
+
+  err =
+      gst_omx_component_get_config (GST_OMX_VIDEO_ENC (self)->enc,
+      QOMX_IndexConfigVideoIntraperiod, &intra);
+  if (err == OMX_ErrorUnsupportedIndex) {
+    GST_WARNING_OBJECT (self,
+        "QOMX_IndexConfigVideoIntraperiod  not supported by component");
+    return TRUE;
+  } else if (err != OMX_ErrorNone) {
+    GST_ERROR_OBJECT (self,
+        "can't get QOMX_IndexConfigVideoIntraperiod %s (0x%08x)",
+        gst_omx_error_to_string (err), err);
+    return FALSE;
+  }
+
+  if (self->interval_intraframes !=
+      GST_OMX_H265_VIDEO_ENC_INTERVAL_OF_CODING_INTRA_FRAMES_DEFAULT) {
+     intra.nPFrames = self->interval_intraframes;
+
+    /* If user specified a specific number of B-frames, reduce the number of
+     * P-frames by this amount. If not ensure there is no B-frame to have the
+     * requested GOP length. */
+    if (self->b_frames != GST_OMX_H265_VIDEO_ENC_B_FRAMES_DEFAULT) {
+      if (self->b_frames > self->interval_intraframes) {
+        GST_ERROR_OBJECT (self,
+            "The interval_intraframes perdiod (%u) \
+            needs to be higher than the number of B-frames (%u)",
+            self->interval_intraframes, self->b_frames);
+        return FALSE;
+      }
+      intra.nPFrames -= self->b_frames;
+      intra.nBFrames = self->b_frames;
+    } else {
+      intra.nBFrames = 0;
+    }
+  }
+
+  err = gst_omx_component_set_config (GST_OMX_VIDEO_ENC(self)->enc,
+      QOMX_IndexConfigVideoIntraperiod, &intra);
+  if (err != OMX_ErrorNone) {
+    GST_ERROR_OBJECT (self, "can't set QOMX_IndexConfigVideoIntraperiod %s (0x%08x)",
+        gst_omx_error_to_string(err), err);
+  }
+
   return TRUE;
 }
 
+static gboolean
+set_hevc_intra_period (GstOMXH265Enc * self)
+{
+  QOMX_VIDEO_INTRAPERIODTYPE intraperiod;
+  OMX_ERRORTYPE err;
+
+  GST_OMX_INIT_STRUCT (&intraperiod);
+  intraperiod.nPortIndex =
+      GST_OMX_VIDEO_ENC (self)->enc_out_port->index;
+
+  err =
+      gst_omx_component_get_config (GST_OMX_VIDEO_ENC (self)->enc,
+      QOMX_IndexConfigVideoIntraperiod, &intraperiod);
+  if (err == OMX_ErrorUnsupportedIndex) {
+    GST_WARNING_OBJECT (self,
+        "QOMX_IndexConfigVideoIntraperiod  not supported by component");
+    return TRUE;
+  } else if (err != OMX_ErrorNone) {
+    GST_ERROR_OBJECT (self,
+        "can't get QOMX_IndexConfigVideoIntraperiod %s (0x%08x)",
+        gst_omx_error_to_string (err), err);
+    return FALSE;
+  }
+
+  GST_DEBUG_OBJECT (self, "default nPFrames:%u, nIDRPeriod:%u",
+      (guint) intraperiod.nPFrames,
+      (guint) intraperiod.nIDRPeriod);
+
+  if (self->periodicity_idr !=
+      GST_OMX_H265_VIDEO_ENC_PERIODICITY_OF_IDR_FRAMES_DEFAULT) {
+    intraperiod.nIDRPeriod = self->periodicity_idr;
+  }
+
+  if (self->interval_intraframes !=
+      GST_OMX_H265_VIDEO_ENC_INTERVAL_OF_CODING_INTRA_FRAMES_DEFAULT) {
+    /* This OMX API doesn't allow us to specify the number of B-frames.
+     * So if user requested one we have to rely on update_param_hevc()
+     * to configure the intraframes interval so it can take the
+     * B-frames into account. */
+    if (self->b_frames == GST_OMX_H265_VIDEO_ENC_B_FRAMES_DEFAULT)
+      intraperiod.nPFrames = self->interval_intraframes;
+  }
+
+  err =
+      gst_omx_component_set_config (GST_OMX_VIDEO_ENC (self)->enc,
+      QOMX_IndexConfigVideoIntraperiod, &intraperiod);
+  if (err != OMX_ErrorNone) {
+    GST_ERROR_OBJECT (self,
+        "can't set QOMX_IndexConfigVideoIntraperiod %s (0x%08x)",
+        gst_omx_error_to_string (err), err);
+    return FALSE;
+  }
+  return TRUE;
+ }
+ #endif
+
 #ifdef USE_OMX_TARGET_ZYNQ_USCALE_PLUS
 static gboolean
 set_intra_period (GstOMXH265Enc * self)
@@ -501,6 +645,15 @@ gst_omx_h265_enc_set_format (GstOMXVideoEnc * enc, GstOMXPort * port,
   OMX_VIDEO_HEVCPROFILETYPE profile = OMX_VIDEO_HEVCProfileUnknown;
   OMX_VIDEO_HEVCLEVELTYPE level = OMX_VIDEO_HEVCLevelUnknown;
 
+#ifdef USE_OMX_TARGET_QTI
+  if (self->periodicity_idr !=
+      GST_OMX_H265_VIDEO_ENC_PERIODICITY_OF_IDR_FRAMES_DEFAULT
+      || self->interval_intraframes !=
+      GST_OMX_H265_VIDEO_ENC_INTERVAL_OF_CODING_INTRA_FRAMES_DEFAULT) {
+    set_hevc_intra_period (self);
+  }
+#endif
+
 #ifdef USE_OMX_TARGET_ZYNQ_USCALE_PLUS
   if (self->periodicity_idr !=
       GST_OMX_H265_VIDEO_ENC_PERIODICITY_OF_IDR_FRAMES_DEFAULT)
