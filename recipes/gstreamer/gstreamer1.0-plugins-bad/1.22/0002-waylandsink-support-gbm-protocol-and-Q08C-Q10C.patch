From c711a87450b417f162c012441f87f1a2d3a92f1f Mon Sep 17 00:00:00 2001
From: Sanjay Chitroda <ckantibh@qti.qualcomm.com>
Date: Tue, 20 May 2025 18:05:34 +0530
Subject: [PATCH] waylandsink: support gbm protocol and Q08C/Q10C.

- Support the wayland gbm_buffer_backend protocol. SHM formats, DMABuf
  formats and GBM formats are exposed differently in caps: the GBM
  formats are flagged with GST_CAPS_FEATURE_MEMORY_GBM. No buffer pool
  is proposed for GBM buffers, it is the upstream element responsibility
  to provide with such buffers.
- Add Q08C/Q10C for wayland to replace UBWC function before. NV12_Q08C
  is equal to NV12+UBWC, NV12_Q10LE32C is equal to
  NV12_10LE32+UBWC+10bit. P010_10LE is reserved.

Upstream-Status: Inappropriate [Qualcomm specific]

Signed-off-by: Sanjay Chitroda <ckantibh@qti.qualcomm.com>
---
 ext/wayland/gstwaylandsink.c             |  41 ++++-
 ext/wayland/gstwaylandsink.h             |   1 +
 gst-libs/gst/wayland/gstwldisplay.c      |  92 +++++++++++
 gst-libs/gst/wayland/gstwldisplay.h      |  10 ++
 gst-libs/gst/wayland/gstwlgbmallocator.c | 187 +++++++++++++++++++++++
 gst-libs/gst/wayland/gstwlgbmallocator.h |  45 ++++++
 gst-libs/gst/wayland/gstwlvideoformat.c  |  94 ++++++++----
 gst-libs/gst/wayland/gstwlvideoformat.h  |  11 ++
 gst-libs/gst/wayland/meson.build         |   9 +-
 gst-libs/gst/wayland/wayland.h           |   1 +
 10 files changed, 456 insertions(+), 35 deletions(-)
 create mode 100644 gst-libs/gst/wayland/gstwlgbmallocator.c
 create mode 100644 gst-libs/gst/wayland/gstwlgbmallocator.h

diff --git a/ext/wayland/gstwaylandsink.c b/ext/wayland/gstwaylandsink.c
index 2adc402..19e5623 100644
--- a/ext/wayland/gstwaylandsink.c
+++ b/ext/wayland/gstwaylandsink.c
@@ -73,14 +73,17 @@ GST_DEBUG_CATEGORY (gstwayland_debug);
 
 #define WL_VIDEO_FORMATS \
     "{ BGRx, BGRA, RGBx, xBGR, xRGB, RGBA, ABGR, ARGB, RGB, BGR, " \
-    "RGB16, BGR16, YUY2, YVYU, UYVY, AYUV, NV12, NV21, NV16, NV61, " \
-    "YUV9, YVU9, Y41B, I420, YV12, Y42B, v308 }"
+    "RGB16, BGR16, YUY2, YVYU, UYVY, AYUV, NV12, P010_10LE, NV21, NV16, " \
+    "NV61, YUV9, YVU9, Y41B, I420, YV12, Y42B, v308, NV12_Q08C, " \
+    "NV12_Q10LE32C }"
 
 static GstStaticPadTemplate sink_template = GST_STATIC_PAD_TEMPLATE ("sink",
     GST_PAD_SINK,
     GST_PAD_ALWAYS,
     GST_STATIC_CAPS (GST_VIDEO_CAPS_MAKE (WL_VIDEO_FORMATS) ";"
         GST_VIDEO_CAPS_MAKE_WITH_FEATURES (GST_CAPS_FEATURE_MEMORY_DMABUF,
+            WL_VIDEO_FORMATS) ";"
+        GST_VIDEO_CAPS_MAKE_WITH_FEATURES (GST_CAPS_FEATURE_MEMORY_GBM,
             WL_VIDEO_FORMATS))
     );
 
@@ -626,7 +629,7 @@ gst_wayland_sink_get_caps (GstBaseSink * bsink, GstCaps * filter)
 
   if (self->display) {
     GValue shm_list = G_VALUE_INIT, dmabuf_list = G_VALUE_INIT;
-    GValue value = G_VALUE_INIT;
+    GValue gbm_list = G_VALUE_INIT, value = G_VALUE_INIT;
     GArray *formats;
     gint i;
     guint fmt;
@@ -634,6 +637,7 @@ gst_wayland_sink_get_caps (GstBaseSink * bsink, GstCaps * filter)
 
     g_value_init (&shm_list, GST_TYPE_LIST);
     g_value_init (&dmabuf_list, GST_TYPE_LIST);
+    g_value_init (&gbm_list, GST_TYPE_LIST);
 
     /* Add corresponding shm formats */
     formats = gst_wl_display_get_shm_formats (self->display);
@@ -665,6 +669,21 @@ gst_wayland_sink_get_caps (GstBaseSink * bsink, GstCaps * filter)
     gst_structure_take_value (gst_caps_get_structure (caps, 1), "format",
         &dmabuf_list);
 
+    /* Add corresponding gbm formats */
+    formats = gst_wl_display_get_gbm_formats (self->display);
+    for (i = 0; i < formats->len; i++) {
+      fmt = g_array_index (formats, uint32_t, i);
+      gfmt = gst_wl_gbm_format_to_video_format (fmt);
+      if (gfmt != GST_VIDEO_FORMAT_UNKNOWN) {
+        g_value_init (&value, G_TYPE_STRING);
+        g_value_set_static_string (&value, gst_wl_gbm_format_to_string (gfmt));
+        gst_value_list_append_and_take_value (&gbm_list, &value);
+      }
+    }
+
+    gst_structure_take_value (gst_caps_get_structure (caps, 2), "format",
+        &gbm_list);
+
     GST_DEBUG_OBJECT (self, "display caps: %" GST_PTR_FORMAT, caps);
   }
 
@@ -710,8 +729,9 @@ static gboolean
 gst_wayland_sink_set_caps (GstBaseSink * bsink, GstCaps * caps)
 {
   GstWaylandSink *self = GST_WAYLAND_SINK (bsink);;
-  gboolean use_dmabuf;
+  gboolean use_dmabuf, use_gbm;
   GstVideoFormat format;
+  GstStructure *structure;
 
   GST_DEBUG_OBJECT (self, "set caps %" GST_PTR_FORMAT, caps);
 
@@ -730,15 +750,22 @@ gst_wayland_sink_set_caps (GstBaseSink * bsink, GstCaps * caps)
   use_dmabuf = gst_caps_features_contains (gst_caps_get_features (caps, 0),
       GST_CAPS_FEATURE_MEMORY_DMABUF);
 
+  use_gbm = gst_caps_features_contains (gst_caps_get_features (caps, 0),
+      GST_CAPS_FEATURE_MEMORY_GBM);
+
   /* validate the format base on the memory type. */
   if (use_dmabuf) {
     if (!gst_wl_display_check_format_for_dmabuf (self->display, format))
       goto unsupported_format;
+  } else if (use_gbm) {
+    if (!gst_wl_display_check_format_for_gbm (self->display, format))
+      goto unsupported_format;
   } else if (!gst_wl_display_check_format_for_shm (self->display, format)) {
     goto unsupported_format;
   }
 
   self->use_dmabuf = use_dmabuf;
+  self->use_gbm  = use_gbm;
 
   return TRUE;
 
@@ -916,7 +943,7 @@ gst_wayland_sink_show_frame (GstVideoSink * vsink, GstBuffer * buffer)
       "display, creating it", buffer);
 
   format = GST_VIDEO_INFO_FORMAT (&self->video_info);
-  if (gst_wl_display_check_format_for_dmabuf (self->display, format)) {
+  if (self->use_dmabuf && gst_wl_display_check_format_for_dmabuf (self->display, format)) {
     guint i, nb_dmabuf = 0;
 
     for (i = 0; i < gst_buffer_n_memory (buffer); i++)
@@ -926,6 +953,10 @@ gst_wayland_sink_show_frame (GstVideoSink * vsink, GstBuffer * buffer)
     if (nb_dmabuf && (nb_dmabuf == gst_buffer_n_memory (buffer)))
       wbuf = gst_wl_linux_dmabuf_construct_wl_buffer (buffer, self->display,
           &self->video_info);
+  } else if (gst_wl_display_check_format_for_gbm (self->display, format)) {
+    if (gst_buffer_n_memory (buffer) == 1 && gst_is_fd_memory (mem))
+      wbuf = gst_wl_gbm_memory_construct_wl_buffer (buffer, self->display,
+          &self->video_info);
   }
 
   if (!wbuf && gst_wl_display_check_format_for_shm (self->display, format)) {
