diff --git a/gst-libs/gst/wayland/gstwlgbmallocator.c b/gst-libs/gst/wayland/gstwlgbmallocator.c
new file mode 100644
index 0000000..248e2c5
--- /dev/null
+++ b/gst-libs/gst/wayland/gstwlgbmallocator.c
@@ -0,0 +1,187 @@
+/* GStreamer Wayland Library
+ *
+ * Copyright (C) 2016 STMicroelectronics SA
+ * Copyright (C) 2016 Fabien Dessenne <fabien.dessenne@st.com>
+ * Copyright (C) 2022 Collabora Ltd.
