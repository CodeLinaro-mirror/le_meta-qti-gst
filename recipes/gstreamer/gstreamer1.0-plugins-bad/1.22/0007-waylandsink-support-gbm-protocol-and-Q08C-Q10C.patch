+gint
+gst_video_format_to_wl_gbm_format (GstVideoFormat format)
+{
+  guint i;
+
+  for (i = 0; i < G_N_ELEMENTS (wl_formats); i++)
+    if (wl_formats[i].gst_format == format)
+      return wl_formats[i].gbm_format;
+
+  GST_WARNING ("wayland gbm video format not found");
+  return -1;
+}
+
