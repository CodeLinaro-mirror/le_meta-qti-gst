@@ -261,6 +280,30 @@ gst_wl_display_check_format_for_dmabuf (GstWlDisplay * self,
   return FALSE;
 }
 
+gboolean
+gst_wl_display_check_format_for_gbm (GstWlDisplay * display,
+    GstVideoFormat format)
+{
+  GstWlDisplayPrivate *priv = gst_wl_display_get_instance_private (display);
+  GArray *formats;
+  guint i, gbm_fmt;
+
+  if (!priv->gbm)
+    return FALSE;
+
+  gbm_fmt = gst_video_format_to_wl_gbm_format (format);
+  if (gbm_fmt == (guint) - 1)
+    return FALSE;
+
+  formats = priv->gbm_formats;
+  for (i = 0; i < formats->len; i++) {
+    if (g_array_index (formats, uint32_t, i) == gbm_fmt)
+      return TRUE;
+  }
+
+  return FALSE;
+}
+
 static void
 handle_xdg_wm_base_ping (void *user_data, struct xdg_wm_base *xdg_wm_base,
     uint32_t serial)
@@ -302,6 +345,25 @@ registry_handle_global (void *data, struct wl_registry *registry,
     priv->dmabuf =
         wl_registry_bind (registry, id, &zwp_linux_dmabuf_v1_interface, 3);
     zwp_linux_dmabuf_v1_add_listener (priv->dmabuf, &dmabuf_listener, self);
+  } else if (g_strcmp0 (interface, "gbm_buffer_backend") == 0) {
+    priv->gbm =
+        wl_registry_bind (registry, id, &gbm_buffer_backend_interface, 1);
+
+    if ((priv->gbmfd = open ("/dev/dri/card0", O_RDWR)) < 0) {
+      priv->gbmfd = open ("/dev/fb0", O_RDWR);
+      g_return_if_fail (priv->gbmfd >= 0);
+    }
+
+    priv->gbmdevice = gbm_create_device (priv->gbmfd);
+    g_return_if_fail (priv->gbmdevice != NULL);
+
+    guint formats[] = {
+        GBM_FORMAT_NV12,
+        GBM_FORMAT_YCbCr_420_P010_VENUS,
+        GBM_FORMAT_YCbCr_420_TP10_UBWC,
+        GBM_FORMAT_YCbCr_420_SP_VENUS_UBWC,
+    };
+    g_array_append_vals (priv->gbm_formats, formats, G_N_ELEMENTS (formats));
   }
 }
 
@@ -431,6 +493,10 @@ gst_wl_display_new_existing (struct wl_display * display,
     g_warning ("Could not bind to zwp_linux_dmabuf_v1");
   }
 
+  if (!priv->gbm) {
+    g_warning ("Could not bind to gbm_buffer_backend");
+  }
+
   if (!priv->xdg_wm_base && !priv->fullscreen_shell) {
     /* If wl_surface and wl_display are passed via GstContext
      * xdg_shell and zwp_fullscreen_shell are not used.
@@ -597,6 +663,29 @@ gst_wl_display_has_own_display (GstWlDisplay * self)
   return priv->own_display;
 }
 
+GArray *gst_wl_display_get_gbm_formats (GstWlDisplay * self)
+{
+  GstWlDisplayPrivate *priv = gst_wl_display_get_instance_private (self);
