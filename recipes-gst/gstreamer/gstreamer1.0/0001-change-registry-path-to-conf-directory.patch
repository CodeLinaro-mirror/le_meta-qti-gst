From 4364ea25c1fd9c393e4e826425a3d7168ba03c34 Mon Sep 17 00:00:00 2001
From: Aashish Patel <aashishpatel@codeaurora.org>
Date: Tue, 24 Aug 2021 16:29:29 +0530
Subject: [PATCH] 0001-change registry path to conf directory

Signed-off-by: Aashish Patel <aashishpatel@codeaurora.org>
---
 gst/gstregistry.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/gst/gstregistry.c b/gst/gstregistry.c
index bada33e..528b1a9 100644
--- a/gst/gstregistry.c
+++ b/gst/gstregistry.c
@@ -1719,8 +1719,8 @@ ensure_current_registry (GError ** error)
   if (registry_file == NULL)
     registry_file = g_strdup (g_getenv ("GST_REGISTRY"));
   if (registry_file == NULL) {
-    registry_file = g_build_filename (g_get_user_cache_dir (),
-        "gstreamer-" GST_API_VERSION, "registry." TARGET_CPU ".bin", NULL);
+    registry_file = g_build_filename ("/etc",
+        "gstreamer-" GST_API_VERSION, ".cache", "registry." TARGET_CPU ".bin", NULL);
   }
 
   if (!_gst_disable_registry_cache) {
-- 
2.17.1

