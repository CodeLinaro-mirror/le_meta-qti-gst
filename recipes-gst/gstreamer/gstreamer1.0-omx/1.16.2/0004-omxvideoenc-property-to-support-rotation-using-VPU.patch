 omx/gstomxh264enc.h  |  1 +
 omx/gstomxh265enc.c  | 58 ++++++++++++++++++++++++++++++++++++++++++++++++++++
 omx/gstomxh265enc.h  |  1 +
 omx/gstomxvideoenc.c | 17 +++++++++++++++
 omx/gstomxvideoenc.h | 11 ++++++++++
 6 files changed, 146 insertions(+)

diff --git a/omx/gstomxh264enc.c b/omx/gstomxh264enc.c
