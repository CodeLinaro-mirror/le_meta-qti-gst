   self->constrained_intra_prediction =
       GST_OMX_H264_VIDEO_ENC_CONSTRAINED_INTRA_PREDICTION_DEFAULT;
   self->loop_filter_mode = GST_OMX_H264_VIDEO_ENC_LOOP_FILTER_MODE_DEFAULT;
+  self->rotate = GST_OMX_VIDEO_ENC_ROTATE_NONE;
 }
 
 static gboolean
@@ -578,6 +594,45 @@ set_brcm_video_intra_period (GstOMXH264Enc * self)
 }
 #endif
 
+/* Updates OMX_CONFIG_ROTATIONTYPE
+ * Reads the current value using get_config
+ * If the current value and desired value are not same, then does set_config */
+static void
+set_frame_rotation (GstOMXH264Enc *self) {
+  OMX_CONFIG_ROTATIONTYPE framerotate;
+  OMX_ERRORTYPE err;
+  guint rotation_deg = self->rotate * 90;
+
+  GST_OMX_INIT_STRUCT (&framerotate);
+  framerotate.nPortIndex = GST_OMX_VIDEO_ENC (self)->enc_out_port->index;
+  err = gst_omx_component_get_config (GST_OMX_VIDEO_ENC(self)->enc,
+      OMX_IndexConfigCommonRotate, &framerotate);
+  if (err == OMX_ErrorUnsupportedIndex) {
+    GST_WARNING_OBJECT (
+        self, "OMX_IndexConfigCommonRotate not supported by component");
+    return;
+  } else if (err != OMX_ErrorNone) {
+    GST_ERROR_OBJECT (self, "can't get OMX_IndexConfigCommonRotate %s (0x%08x)",
+        gst_omx_error_to_string(err), err);
+    return;
+  }
+
+  GST_DEBUG_OBJECT (self, "current rotation angle:%u, new rotation angle:%u",
+      (guint)framerotate.nRotation, (guint)rotation_deg);
+
+  if (rotation_deg == framerotate.nRotation)
+    return;
+
+  framerotate.nRotation = rotation_deg;
+  err = gst_omx_component_set_config (GST_OMX_VIDEO_ENC(self)->enc,
+      OMX_IndexConfigCommonRotate, &framerotate);
+  if (err != OMX_ErrorNone) {
+    GST_ERROR_OBJECT (self, "can't set OMX_IndexConfigCommonRotate %s (0x%08x)",
+        gst_omx_error_to_string(err), err);
+  }
+  return;
+}
+
 static gboolean
 gst_omx_h264_enc_set_format (GstOMXVideoEnc * enc, GstOMXPort * port,
     GstVideoCodecState * state)
@@ -654,6 +709,9 @@ gst_omx_h264_enc_set_format (GstOMXVideoEnc * enc, GstOMXPort * port,
     set_brcm_video_intra_period (self);
 #endif
 
+   if (self->rotate != GST_OMX_VIDEO_ENC_ROTATE_NONE)
+      set_frame_rotation (self);
+
   gst_omx_port_get_port_definition (GST_OMX_VIDEO_ENC (self)->enc_out_port,
       &port_def);
   port_def.format.video.eCompressionFormat = OMX_VIDEO_CodingAVC;
