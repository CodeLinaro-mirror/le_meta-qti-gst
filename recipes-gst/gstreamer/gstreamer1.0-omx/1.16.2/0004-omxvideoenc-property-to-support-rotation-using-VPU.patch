+GType
+gst_omx_video_enc_rotate_get_type (void)
+{
+  static GType qtype = 0;
+  if (qtype == 0) {
+    static const GEnumValue values[] = {
+      {GST_OMX_VIDEO_ENC_ROTATE_NONE, "No rotation", "none" },
+      {GST_OMX_VIDEO_ENC_ROTATE_90_CW, "Rotate 90 degrees clockwise", "90CW"},
+      {GST_OMX_VIDEO_ENC_ROTATE_180, "Rotate 180 degrees", "180"},
+      {GST_OMX_VIDEO_ENC_ROTATE_90_CCW, "Rotate 90 degrees counter-clockwise", "90CCW"},
+      {0, NULL, NULL},
+    };
+    qtype = g_enum_register_static ("GstOmxVideoEncRotate", values);
+  }
+  return qtype;
+}
